---
// Maschinenraum — Live-Status der eigenen Systeme (Konzept 22.10.2026).
// Daten: GET /api/maschinenraum (functions/api/maschinenraum.js liest das
// R2-Objekt, das der lokale Publisher ~/.claude/skills/maschinenraum schreibt).
// Beschriftungen stehen nur hier: Das JSON enthält IDs, Zustände, Daten und
// Zahlen, aber keinen Text. Ohne JavaScript oder Daten bleiben die festen
// Beschreibungen stehen — nie ein erfundenes Grün.
export interface Props { lang: 'de' | 'en' }
const { lang } = Astro.props;

// von/nach beschriften das Schaltbild (woraus ein System liest, was es abliefert),
// tempo ist die Umlaufzeit des Datenpakets in Sekunden und folgt dem Rhythmus.
// leer: true blendet ein System aus, solange es keine Daten meldet ("unbekannt").
const systeme = [
	{ id: 'morgen-briefing', name: { de: 'morgen-briefing', en: 'morning-briefing' }, rhythmus: { de: 'täglich', en: 'daily' }, tempo: 3.4,
	  von: { de: 'Mail · Kalender · Aufgaben', en: 'Mail · calendar · tasks' }, nach: { de: 'Sprachnachricht', en: 'Voice message' },
	  desc: { de: 'Tagesbriefing aus Mail, Kalender und Aufgaben, als Sprachnachricht.', en: 'Daily briefing from mail, calendar and tasks, delivered as a voice message.' } },
	{ id: 'website-monitoring', name: { de: 'website-monitoring', en: 'website-monitoring' }, rhythmus: { de: 'täglich', en: 'daily' }, tempo: 3.4,
	  von: { de: 'Meine Websites', en: 'My websites' }, nach: { de: 'Prüfprotokoll', en: 'Check log' },
	  desc: { de: 'Uptime, Kontaktformular, PageSpeed und Besucherzahlen meiner Websites.', en: 'Uptime, contact form, PageSpeed and visitor stats for my websites.' } },
	{ id: 'datensicherung', name: { de: 'datensicherung', en: 'backups' }, rhythmus: { de: 'laufend', en: 'continuous' }, tempo: 2.2,
	  von: { de: 'Rechner · Ablage', en: 'Machine · archive' }, nach: { de: 'Sicherungskopien', en: 'Backup copies' },
	  desc: { de: 'Sicherung von Rechner und Dokumentenablage.', en: 'Backups of my machine and document archive.' } },
	{ id: 'pagespeed-wache', name: { de: 'pagespeed-wache', en: 'pagespeed-watch' }, rhythmus: { de: 'wöchentlich', en: 'weekly' }, tempo: 5,
	  von: { de: 'Betreute Websites', en: 'Websites I look after' }, nach: { de: 'Messreihe', en: 'Time series' },
	  desc: { de: 'Misst die Ladezeit der Websites, die ich betreue.', en: 'Measures load times of the websites I look after.' } },
	{ id: 'gsc-wochenbericht', name: { de: 'gsc-wochenbericht', en: 'gsc-weekly-report' }, rhythmus: { de: 'wöchentlich', en: 'weekly' }, tempo: 5,
	  von: { de: 'Search Console', en: 'Search Console' }, nach: { de: 'Wochenbericht', en: 'Weekly report' },
	  desc: { de: 'Search-Console-Bericht für pragma-code.de.', en: 'Search Console report for pragma-code.de.' } },
	{ id: 'citation-tracker', name: { de: 'citation-tracker', en: 'citation-tracker' }, rhythmus: { de: 'täglich', en: 'daily' }, tempo: 3.4,
	  von: { de: 'KI-Antworten', en: 'AI answers' }, nach: { de: 'Zitationsbericht', en: 'Citation report' },
	  desc: { de: 'Eigenes SaaS: misst, ob Marken in KI-Antworten zitiert werden.', en: 'My own SaaS: tracks whether brands are cited in AI answers.' } },
	{ id: 'lead-agent', name: { de: 'lead-agent', en: 'lead-agent' }, rhythmus: { de: 'bei Eingang', en: 'on arrival' }, tempo: 2.6,
	  von: { de: 'Anfragen', en: 'Inquiries' }, nach: { de: 'Antwortentwurf', en: 'Draft reply' },
	  desc: { de: 'Sortiert Anfragen vor und entwirft Antworten; gesendet wird nie automatisch.', en: 'Triages inquiries and drafts replies; nothing is ever sent automatically.' } },
	{ id: 'content-fabrik', name: { de: 'content-fabrik', en: 'content-factory' }, rhythmus: { de: 'laufend', en: 'continuous' }, tempo: 2.2, leer: true,
	  von: { de: 'Idee · Mediathek', en: 'Idea · media library' }, nach: { de: 'Beitrag', en: 'Post' },
	  band: [
		{ de: 'Mediathek', en: 'Library' }, { de: 'Entwurf', en: 'Draft' },
		{ de: 'Freigabe', en: 'Approval', tor: true }, { de: 'Veröffentlichung', en: 'Publishing' }
	  ],
	  desc: { de: 'Baut aus Idee und Mediathek fertige Social-Media-Beiträge; veröffentlicht wird nur nach meiner Freigabe.', en: 'Turns an idea and a media library into finished social posts; nothing is published without my approval.' } },
	{ id: 'reels-radar', name: { de: 'reels-radar', en: 'reels-radar' }, rhythmus: { de: 'nächtlich', en: 'nightly' }, tempo: 3.4,
	  von: { de: 'Social Media', en: 'Social media' }, nach: { de: 'Wettbewerbsbild', en: 'Competitor overview' },
	  desc: { de: 'Beobachtet Social-Media-Wettbewerber über Bright Data.', en: 'Watches social media competitors via Bright Data.' } },
	{ id: 'akquise', name: { de: 'akquise', en: 'prospecting' }, rhythmus: { de: 'bei Bedarf', en: 'on demand' }, tempo: 4.2, leer: true,
	  von: { de: 'Öffentliche Quellen', en: 'Public sources' }, nach: { de: 'Firmenliste', en: 'Company list' },
	  desc: { de: 'Sucht in öffentlichen Quellen nach passenden Unternehmen; eine Wache meldet verstummte Quellen.', en: 'Searches public sources for matching companies; a watchdog reports sources that go quiet.' } },
	{ id: 'career-ops', name: { de: 'ausschreibungs-radar', en: 'listings radar' }, rhythmus: { de: 'bei Bedarf', en: 'on demand' }, tempo: 4.2, leer: true,
	  von: { de: 'Ausschreibungen', en: 'Listings' }, nach: { de: 'Trefferliste', en: 'Shortlist' },
	  desc: { de: 'Durchsucht öffentliche Ausschreibungen nach passenden Angeboten; eine Wache meldet verstummte Quellen.', en: 'Scans public listings for matching opportunities; a watchdog reports sources that go quiet.' } }
];

const kopf = lang === 'de'
	? { von: 'Quellen', system: 'Systeme', nach: 'Ergebnisse' }
	: { von: 'Sources', system: 'Systems', nach: 'Results' };

const texte = {
	de: {
		zustand: { aktiv: 'aktiv', teilweise: 'teilweise', bei_bedarf: 'bei Bedarf', pausiert: 'pausiert',
			im_aufbau: 'im Aufbau', ueberfaellig: 'überfällig', fehler: 'Fehler', unbekannt: 'keine Daten' },
		heute: 'heute', gestern: 'gestern', vorTagen: 'vor {n} Tagen', zuletzt: 'zuletzt {rel}', seit: 'seit {monat}',
		wert: {
			'morgen-briefing': '{ok}/{von} Tage erstellt',
			'website-monitoring': '{ok}/{von} Läufe erfolgreich',
			'datensicherung': '{ok}/{von} Sicherungen aktuell',
			'pagespeed-wache': '{seiten} Seiten · diese Seite mobil {mobil}',
			'pagespeed-wache-ohne': '{seiten} Seiten',
			'gsc-wochenbericht:aktiv': 'erstellt und zugestellt',
			'gsc-wochenbericht:teilweise': 'erstellt, Zustellung gestört',
			'citation-tracker:aktiv': 'Zitationen abgefragt',
			'citation-tracker:pausiert': 'Wiederanlauf mit dem nächsten Mandanten',
			'lead-agent:aktiv': 'läuft gerade',
			'lead-agent:bei_bedarf': 'wird von Hand gestartet',
			'content-fabrik': '{beitraege} Beiträge in 30 Tagen veröffentlicht',
			'reels-radar:im_aufbau': 'Testlauf erfolgreich, Nachtlauf folgt',
			'akquise:teilweise': 'eine Quelle ist verstummt, gemeldet',
			'akquise:fehler': 'alle Quellen verstummt, gemeldet',
			'career-ops:teilweise': 'eine Quelle ist verstummt, gemeldet',
			'career-ops:fehler': 'alle Quellen verstummt, gemeldet'
		},
		standMin: 'Stand: vor {n} Min.', standStd: 'Stand: vor {n} Std.', standTage: 'Stand: vor {n} Tagen',
		standZusatz: ' · automatisch erzeugt, nicht nachbearbeitet',
		nichtAbrufbar: 'Live-Status gerade nicht abrufbar.',
		footer: { neutral: 'Systemstatus ansehen', aktiv: '{n} Systeme aktiv', warn1: ' · 1 braucht Aufmerksamkeit',
			warnN: ' · {w} brauchen Aufmerksamkeit', bad1: ' · 1 mit Fehler', badN: ' · {b} mit Fehler' }
	},
	en: {
		zustand: { aktiv: 'running', teilweise: 'partial', bei_bedarf: 'on demand', pausiert: 'paused',
			im_aufbau: 'in development', ueberfaellig: 'overdue', fehler: 'failed', unbekannt: 'no data' },
		heute: 'today', gestern: 'yesterday', vorTagen: '{n} days ago', zuletzt: 'last {rel}', seit: 'since {monat}',
		wert: {
			'morgen-briefing': '{ok}/{von} days delivered',
			'website-monitoring': '{ok}/{von} runs successful',
			'datensicherung': '{ok}/{von} backups current',
			'pagespeed-wache': '{seiten} pages · this site mobile {mobil}',
			'pagespeed-wache-ohne': '{seiten} pages',
			'gsc-wochenbericht:aktiv': 'created and delivered',
			'gsc-wochenbericht:teilweise': 'created, delivery failing',
			'citation-tracker:aktiv': 'citations checked',
			'citation-tracker:pausiert': 'restarts with the next client',
			'lead-agent:aktiv': 'running right now',
			'lead-agent:bei_bedarf': 'started manually',
			'content-fabrik': '{beitraege} posts published in 30 days',
			'reels-radar:im_aufbau': 'test run successful, nightly run next',
			'akquise:teilweise': 'a source went quiet, reported',
			'akquise:fehler': 'all sources quiet, reported',
			'career-ops:teilweise': 'a source went quiet, reported',
			'career-ops:fehler': 'all sources quiet, reported'
		},
		standMin: 'Updated {n} min ago', standStd: 'Updated {n} h ago', standTage: 'Updated {n} days ago',
		standZusatz: ' · generated automatically, not edited',
		nichtAbrufbar: 'Live status is currently unavailable.',
		footer: { neutral: 'View system status', aktiv: '{n} systems running', warn1: ' · 1 needs attention',
			warnN: ' · {w} need attention', bad1: ' · 1 failed', badN: ' · {b} failed' }
	}
}[lang];

// Terminal-Befehl je Sprache — die System-IDs im JSON bleiben deutsch.
const befehl = lang === 'de' ? 'maschinenraum' : 'engine-room';

const initialStand = lang === 'de'
	? 'Live-Status: stündlich automatisch aus den Systemen.'
	: 'Live status: generated hourly from the systems themselves.';
---

<div class="mr" data-mr data-lang={lang}>
	<div class="mr-bar pc-mono" aria-hidden="true">
		<span class="mr-dots"><i></i><i></i><i></i></span>alexander@ohl — {befehl}
	</div>
	<div class="mr-plan" aria-hidden="true" data-mr-plan>
		<div class="mr-plan-kopf"><span>{kopf.von}</span><span>{kopf.system}</span><span>{kopf.nach}</span></div>
		{systeme.map((s, i) => (
			<div class="mr-lane" data-id={s.id} data-zustand="unbekannt" data-leer={s.leer} hidden={s.leer}
				style={`--mr-t:${s.tempo}s;--mr-v:${((i * 0.37) % 1.9).toFixed(2)}s`}>
				<span class="mr-von">{s.von[lang]}</span>
				<span class="mr-draht mr-draht-a"><i></i></span>
				<span class="mr-kasten">
					<span class="mr-dot"></span>
					<span class="mr-kname">{s.name[lang]}</span>
					<svg class="mr-rad" viewBox="0 0 20 20" width="15" height="15"><circle cx="10" cy="10" r="7.2" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="2.83 2.83"/><circle cx="10" cy="10" r="4.6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
				</span>
				<span class="mr-draht mr-draht-b"><i></i></span>
				<span class="mr-nach">{s.nach[lang]}</span>
				{s.band && (
					<span class="mr-band">
						<span class="mr-band-spur"><i></i></span>
						{s.band.map(b => <span class="mr-station" data-tor={b.tor}>{b[lang]}</span>)}
					</span>
				)}
			</div>
		))}
	</div>
	<div class="mr-body">
		<p class="mr-cmd" aria-hidden="true"><span class="mr-prompt">alexander@ohl</span>:~$ {befehl} status</p>
		<ul class="mr-list">
			{systeme.map(s => (
				<li class="mr-row" data-id={s.id} data-zustand="unbekannt" data-leer={s.leer} hidden={s.leer}>
					<span class="mr-dot" aria-hidden="true"></span>
					<span class="mr-name">{s.name[lang]}</span>
					<span class="mr-status"><span data-mr-zustand>—</span><span class="mr-wann" data-mr-wann></span></span>
					<span class="mr-desc"><span class="mr-rhythmus">{s.rhythmus[lang]}</span> · {s.desc[lang]}</span>
					<span class="mr-wert" data-mr-wert></span>
				</li>
			))}
		</ul>
		<p class="mr-stand" data-mr-stand aria-live="polite">{initialStand}</p>
	</div>
	<script type="application/json" data-mr-texte set:html={JSON.stringify(texte)} />
</div>

<script>
	type Sys = { id: string; zustand: string; zuletzt?: string | null; seit?: string | null; werte?: Record<string, number> };

	const root = document.querySelector<HTMLElement>('[data-mr]');
	if (root) {
		void laden(root);
		bewegung(root);
	}

	// Animationen laufen nur, solange das Schaltbild im Bild ist.
	function bewegung(root: HTMLElement) {
		const plan = root.querySelector('[data-mr-plan]');
		if (!plan || !('IntersectionObserver' in window)) { root.classList.add('mr-laeuft'); return; }
		new IntersectionObserver(e => root.classList.toggle('mr-laeuft', e.some(x => x.isIntersecting)),
			{ rootMargin: '80px' }).observe(plan);
	}

	function fuelle(tpl: string, werte: Record<string, string | number>) {
		return tpl.replace(/\{(\w+)\}/g, (_, k) => String(werte[k] ?? ''));
	}

	// Kalenderdaten kommen in Europe/Berlin; verglichen wird mit dem heutigen
	// Datum dort, damit „heute“ für DACH-Besucher stimmt.
	function tageSeit(datum: string) {
		const heute = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Berlin' }).format(new Date());
		return Math.round((Date.parse(heute) - Date.parse(datum)) / 86_400_000);
	}

	function relDatum(datum: string, T: any, lang: string) {
		const n = tageSeit(datum);
		if (n <= 0) return T.heute;
		if (n === 1) return T.gestern;
		if (n <= 30) return fuelle(T.vorTagen, { n });
		return new Date(datum + 'T12:00:00Z').toLocaleDateString(lang === 'de' ? 'de-DE' : 'en-GB',
			{ day: 'numeric', month: 'short', year: 'numeric' });
	}

	function monat(seit: string, lang: string) {
		return new Date(seit + '-15T12:00:00Z').toLocaleDateString(lang === 'de' ? 'de-DE' : 'en-GB',
			{ month: 'short', year: 'numeric' });
	}

	function wann(s: Sys, T: any, lang: string) {
		if ((s.zustand === 'pausiert' || s.zustand === 'im_aufbau') && s.seit) return fuelle(T.seit, { monat: monat(s.seit, lang) });
		if (!s.zuletzt) return '';
		const rel = relDatum(s.zuletzt, T, lang);
		return s.zustand === 'bei_bedarf' ? fuelle(T.zuletzt, { rel }) : rel;
	}

	function wert(s: Sys, T: any) {
		const w = s.werte ?? {};
		if (s.id === 'pagespeed-wache') return fuelle(w.mobil != null ? T.wert[s.id] : T.wert['pagespeed-wache-ohne'], w);
		const tpl = T.wert[`${s.id}:${s.zustand}`] ?? (Object.keys(w).length ? T.wert[s.id] : undefined);
		return tpl ? fuelle(tpl, w) : '';
	}

	function stand(iso: string, T: any) {
		const min = Math.max(0, Math.round((Date.now() - Date.parse(iso)) / 60_000));
		const basis = min < 120 ? fuelle(T.standMin, { n: min })
			: min < 48 * 60 ? fuelle(T.standStd, { n: Math.round(min / 60) })
			: fuelle(T.standTage, { n: Math.round(min / 1440) });
		return basis + T.standZusatz;
	}

	function footer(systeme: Sys[], T: any) {
		const el = document.querySelector<HTMLElement>('[data-mr-footer]');
		const text = el?.querySelector('[data-mr-footer-text]');
		if (!el || !text) return;
		const n = systeme.filter(s => s.zustand === 'aktiv').length;
		const w = systeme.filter(s => s.zustand === 'teilweise' || s.zustand === 'ueberfaellig').length;
		const b = systeme.filter(s => s.zustand === 'fehler').length;
		let t = fuelle(T.footer.aktiv, { n });
		if (b) t += b === 1 ? T.footer.bad1 : fuelle(T.footer.badN, { b });
		if (w) t += w === 1 ? T.footer.warn1 : fuelle(T.footer.warnN, { w });
		text.textContent = t;
		el.dataset.zustand = b ? 'bad' : w ? 'warn' : 'ok';
	}

	async function laden(root: HTMLElement) {
		const lang = root.dataset.lang ?? 'de';
		const T = JSON.parse(root.querySelector('[data-mr-texte]')?.textContent ?? '{}');
		const standEl = root.querySelector('[data-mr-stand]');
		let doc: { stand: string; systeme: Sys[] } | null = null;
		try {
			const r = await fetch('/api/maschinenraum', { headers: { Accept: 'application/json' } });
			if (r.ok) doc = await r.json();
		} catch { /* bleibt null */ }
		if (!doc || !Array.isArray(doc.systeme)) {
			if (standEl) standEl.textContent = T.nichtAbrufbar;
			return;
		}
		for (const s of doc.systeme) {
			// Jede ID gibt es zweimal: als Bahn im Schaltbild und als Zeile im Terminal.
			const teile = root.querySelectorAll<HTMLElement>(`[data-id="${CSS.escape(s.id)}"]`);
			for (const el of teile) {
				el.dataset.zustand = s.zustand;
				if (el.dataset.leer != null) el.hidden = s.zustand === 'unbekannt';
			}
			const row = root.querySelector<HTMLElement>(`.mr-row[data-id="${CSS.escape(s.id)}"]`);
			if (!row) continue;
			const z = row.querySelector('[data-mr-zustand]');
			const wa = row.querySelector('[data-mr-wann]');
			const we = row.querySelector('[data-mr-wert]');
			if (z) z.textContent = T.zustand[s.zustand] ?? T.zustand.unbekannt;
			if (wa) wa.textContent = wann(s, T, lang);
			if (we) we.textContent = wert(s, T);
		}
		if (standEl) standEl.textContent = stand(doc.stand, T);
		footer(doc.systeme, T);
	}
</script>

<style>
	.mr {
		--mr-red: #ff6b6b;
		background: var(--pc-navy-900);
		border: 1px solid var(--pc-line-2);
		border-radius: var(--pc-r-lg);
		overflow: hidden;
	}
	.mr-bar {
		display: flex; align-items: center; gap: 12px;
		padding: 11px 16px; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase;
		color: var(--pc-fg-3); border-bottom: 1px solid var(--pc-line); background: var(--pc-navy-800);
	}
	.mr-dots { display: inline-flex; gap: 6px; }
	.mr-dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--pc-line-2); }
	.mr-dots i:nth-child(1) { background: #ff5f57; }
	.mr-dots i:nth-child(2) { background: #febc2e; }
	.mr-dots i:nth-child(3) { background: #28c840; }
	.mr-body { padding: clamp(16px, 3vw, 26px); }
	.mr-row[hidden], .mr-lane[hidden] { display: none; }

	/* ---------- Schaltbild: Quelle → System → Ergebnis ----------
	   Bewegung folgt dem gemeldeten Zustand: Pakete und Zahnrad laufen nur bei
	   "aktiv"/"teilweise"; pausierte und unbekannte Systeme stehen still. Nur
	   Raster und Lichtband im Hintergrund laufen immer. */
	.mr-plan {
		--mr-farbe: var(--pc-fg-3);
		position: relative; isolation: isolate; overflow: hidden;
		padding: clamp(14px, 2.6vw, 22px) clamp(16px, 3vw, 26px);
		border-bottom: 1px solid var(--pc-line);
	}
	.mr-plan::before {
		content: ''; position: absolute; inset: -32px; z-index: -1; opacity: 0.55;
		background-image: linear-gradient(var(--pc-line) 1px, transparent 1px), linear-gradient(90deg, var(--pc-line) 1px, transparent 1px);
		background-size: 32px 32px;
		animation: mr-raster 16s linear infinite;
	}
	.mr-plan::after {
		content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: 28%; z-index: -1;
		background: linear-gradient(90deg, transparent, rgba(255, 200, 41, 0.055), transparent);
		animation: mr-licht 11s linear infinite;
	}
	@keyframes mr-raster { to { transform: translate(32px, 32px); } }
	@keyframes mr-licht { from { transform: translateX(-110%); } to { transform: translateX(470%); } }

	.mr-plan-kopf, .mr-lane {
		display: grid; align-items: center; column-gap: 10px;
		grid-template-columns: minmax(0, 1fr) clamp(36px, 7vw, 96px) minmax(170px, 230px) clamp(36px, 7vw, 96px) minmax(0, 1fr);
	}
	.mr-plan-kopf {
		font-family: var(--pc-font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
		color: var(--pc-fg-3); margin-bottom: 8px;
	}
	.mr-plan-kopf span:nth-child(1) { text-align: right; }
	.mr-plan-kopf span:nth-child(2) { grid-column: 3; text-align: center; }
	.mr-plan-kopf span:nth-child(3) { grid-column: 5; }
	.mr-lane {
		grid-template-areas: "von da kasten db nach" ". band band band .";
		padding: 5px 0;
	}
	.mr-von, .mr-nach { font-size: 12.5px; line-height: 1.3; color: var(--pc-fg-2); }
	.mr-von { grid-area: von; text-align: right; }
	.mr-nach { grid-area: nach; color: var(--pc-fg); }

	.mr-draht { position: relative; height: 1px; background: var(--pc-line-2); }
	.mr-draht-a { grid-area: da; }
	.mr-draht-b { grid-area: db; }
	.mr-draht::after {
		content: ''; position: absolute; right: -1px; top: -3px;
		border-left: 5px solid var(--pc-fg-3); border-top: 3.5px solid transparent; border-bottom: 3.5px solid transparent;
	}
