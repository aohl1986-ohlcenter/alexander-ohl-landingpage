	<script>
		// Interaktives Hero-Terminal mit CLI-Befehlen, History und Klick-Chips
		const PROMPT_STR = 'alexander@ohl ~ % ';
		const historyEl = document.getElementById('term-history');
		const inputEl = document.getElementById('term-input') as HTMLInputElement | null;
		const formEl = document.getElementById('term-form');
		const containerEl = document.getElementById('term-container');
		const chips = document.querySelectorAll('.term-chip');

		const cmdHistory: string[] = [];
		let historyIdx = -1;

		const COMMANDS: Record<string, string> = {
			help: `Verfügbare Befehle:
  whoami       - Steckbrief & Rolle von Alexander Ohl
  skills       - Tech-Stack, Sprachen & Frameworks
  principles   - 4 unverrückbare Arbeits- & Architektur-Prinzipien
  projects     - Ausgewählte Kundenprojekte & SaaS-Produkte
  call         - 30-Min. Discovery-Call vereinbaren
  pricing      - Pakete, Festpreise & monatliche Retainer
  contact      - Kontaktmöglichkeiten (E-Mail, Projektanfrage)
  clear        - Terminalausgabe leeren`,

			whoami: `Alexander Ohl — KI-Automatisierungs-Engineer & Gründer von Pragma-Code.
15+ Jahre Praxiserfahrung in Softwarearchitektur, KI-Automatisierung (n8n, RAG), SEO & GEO und E-Commerce im DACH-Raum.`,

			skills: `⚡ Tech-Stack & Kernkompetenzen:
• Frontend: React, Next.js, Astro, TypeScript, Tailwind CSS
• Backend: Node.js, Python, PHP, REST-APIs, SQL, Docker, Git
• KI & Automatisierung: n8n, RAG-Pipelines, LLM-Agenten, Gemini API, RPA
• Sichtbarkeit & Commerce: SEO, GEO (Generative Engine Optimization), Shopify, WooCommerce, JTL`,

			principles: `⚙️ Meine 4 Arbeitsprinzipien:
1. Kein Vendor Lock-in (Open-Source-First, 100 % Datenautonomie)
2. Messbarer ROI statt Hype (Zeitersparnis, Klicks & Leads)
3. Radikale Performance (Sub-Sekunden-Ladezeiten, Core Web Vitals 100/100)
4. DSGVO & Datensouveränität (Hosting im DACH-Raum, On-Premise-LLMs)`,

			projects: `📁 Top Kundenprojekte & Referenzen:
• EsenTrans (esentrans.de): WordPress-Schema-Plugin (+111 % Klicks)
• AI-Citation-Tracker (pragma-code.de): Multi-Tenant SaaS für KI-Zitationen
• ImkerPur (imkerpur.de/lp): JTL-Shop & SEO-Landingpages
• N&W Reisemobile (n-w-reisemobile.de): Webpräsenz, SEO & Social Media
• Physiotherapie Osnabrück: Webdesign & Local SEO
• Shooting Solutions (shooting-solutions.de): 6-Monate SEO-Sprint`,

			call: `📅 Kostenlosen 30-Min. Discovery-Call mit Alexander buchen:
👉 https://calendly.com/pragma-code-info/discovery-call`,

			pricing: `💰 Pakete & Preise von Pragma-Code:
• KI-Sichtbarkeits-Monitoring: ab 149 €/Monat (monatlich kündbar)
• Monatliche Retainer (Web/SEO/KI): ab 390 €/Monat
• Festpreis-Projekte & Audits: ab 690 €
Übersicht: https://www.pragma-code.de/pakete-preise`,

			contact: `📬 Kontakt aufnehmen:
• E-Mail: info@pragma-code.de
• Projektanfrage: https://www.pragma-code.de/projektanfrage
• LinkedIn: https://www.linkedin.com/in/alexander-ohl/`,

			sudo: `zsh: permission denied: Netter Versuch! Sie haben bereits vollen Zugriff, um die Website zu erkunden.`
		};

		function appendOutput(cmd: string, output: string) {
			if (!historyEl) return;
			const item = document.createElement('div');
			item.className = 'term-entry';
			item.innerHTML = `<div class="term-line"><span class="p pc-mono">${PROMPT_STR}</span><span class="cmd-text">${escapeHtml(cmd)}</span></div>${output ? `<div class="o pc-mono">${escapeHtml(output)}</div>` : ''}`;
			historyEl.appendChild(item);
			if (containerEl) {
				containerEl.scrollTop = containerEl.scrollHeight;
			}
		}

		function escapeHtml(str: string) {
			return str
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;');
		}

		function executeCommand(rawCmd: string) {
			const cmd = rawCmd.trim().toLowerCase();
			if (!cmd) return;

			cmdHistory.push(rawCmd);
			historyIdx = cmdHistory.length;

			if (cmd === 'clear') {
				if (historyEl) historyEl.innerHTML = '';
				return;
			}

			if (cmd in COMMANDS) {
				appendOutput(rawCmd, COMMANDS[cmd]);
			} else if (cmd === 'stack') {
				appendOutput(rawCmd, COMMANDS['skills']);
			} else if (cmd === 'refs' || cmd === 'referenzen') {
				appendOutput(rawCmd, COMMANDS['projects']);
			} else if (cmd === 'book' || cmd === 'termin') {
				appendOutput(rawCmd, COMMANDS['call']);
			} else if (cmd === 'mail' || cmd === 'email') {
				appendOutput(rawCmd, COMMANDS['contact']);
			} else {
				appendOutput(rawCmd, `zsh: command not found: ${cmd}. Tippen Sie 'help' für eine Befehlsübersicht.`);
			}
		}

		// Initiale Begrüßungszeilen
		const initialLines = [
			{ cmd: 'whoami', out: 'Alexander Ohl — IT-Generalist & KI-Engineer' },
			{ cmd: 'cat stack.txt', out: 'Web · SEO/GEO · KI-Automatisierung · E-Commerce' },
			{ cmd: './verfuegbarkeit.sh', out: '● verfügbar für Projekte — DACH · Remote' }
		];

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (reduced) {
			initialLines.forEach(l => appendOutput(l.cmd, l.out));
		} else {
			(async () => {
				const sleep = (ms: number) => new Promise(r => setTimeout(r, ms));
				for (const l of initialLines) {
					appendOutput(l.cmd, l.out);
					await sleep(180);
				}
			})();
		}

		// Event Listener für Formular & Eingabe
		formEl?.addEventListener('submit', (e) => {
			e.preventDefault();
			if (!inputEl) return;
			const val = inputEl.value;
			inputEl.value = '';
			executeCommand(val);
		});

		inputEl?.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowUp') {
				e.preventDefault();
				if (historyIdx > 0) {
					historyIdx--;
					inputEl.value = cmdHistory[historyIdx] || '';
				}
			} else if (e.key === 'ArrowDown') {
				e.preventDefault();
				if (historyIdx < cmdHistory.length - 1) {
					historyIdx++;
					inputEl.value = cmdHistory[historyIdx] || '';
				} else {
					historyIdx = cmdHistory.length;
					inputEl.value = '';
				}
			}
		});

		// Klick-Chips
		chips.forEach(chip => {
			chip.addEventListener('click', () => {
				const cmd = chip.getAttribute('data-cmd');
				if (cmd) {
					executeCommand(cmd);
					if (inputEl) inputEl.focus();
				}
			});
		});

		// WebMCP: Profil-Tool für KI-Browser registrieren (Progressive Enhancement)
		if (typeof navigator !== 'undefined' && 'modelContext' in navigator) {
			(navigator as any).modelContext.registerTool({
				name: 'getProfile',
				description: 'Liefert Profil, Kompetenzen und Kontaktdaten von Alexander Ohl (KI-Automatisierungs-Engineer).',
				parameters: { type: 'object', properties: {} },
				execute: async () => ({
					status: 'success',
					name: 'Alexander Ohl',
					role: 'KI-Automatisierungs-Engineer & Full-Stack-Entwickler',
					skills: ['KI-Automatisierung (RAG, n8n, Agenten)', 'Webentwicklung (React, Next.js, Astro)', 'SEO & GEO', 'E-Commerce'],
					area: 'DACH · Remote',
					contact: 'info@pragma-code.de',
					company: 'https://www.pragma-code.de'
				})
			});
		}
	</script>

