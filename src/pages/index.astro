import { posts } from '../data/posts';
import { PERSON_ID, jobTitle, personSameAs, pragmaCodeOrganization } from '../data/person';
import Maschinenraum from '../components/Maschinenraum.astro';
import Kundenstimmen from '../components/Kundenstimmen.astro';
import CareerChapters, { type CareerChapter } from '../components/CareerChapters.astro';
import { werdegangCommits, jsonForScript } from '../data/werdegang-git';

// Tech-Stack: mit offiziellen Herstellerseiten verlinkt (Konzepte ohne URL bleiben Text).
