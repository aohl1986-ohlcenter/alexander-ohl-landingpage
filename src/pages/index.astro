---

<Layout
	title="Alexander Ohl | KI-Automatisierungs-Engineer & Full-Stack-Entwickler"
	description="Alexander Ohl — KI-Automatisierungs-Engineer und Gründer von Pragma-Code: 15+ Jahre Erfahrung in KI-Automatisierung, Webentwicklung, SEO/GEO und E-Commerce. Remote im DACH-Raum."
>
	<Fragment slot="head">
		<link rel="preload" as="image" href="/assets/alexander-ohl-buero-1200.webp" fetchpriority="high" />
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
	</Fragment>

	<!-- HEADER -->
	<header class="hd">
		<div class="pc-container hd-inner">
			<a class="hd-logo" href="/" aria-label="Alexander Ohl — Startseite">
				<span class="prompt">alexander@ohl</span><span class="tilde">:~$</span><span class="caret" aria-hidden="true"></span>
			</a>
			<nav class="hd-nav" aria-label="Hauptnavigation">
				<a href="#expertise">Expertise</a>
				<a href="#prinzipien">Prinzipien</a>
				<a href="#werdegang">Werdegang</a>
				<a href="#referenzen">Referenzen</a>
				<a href="#fachartikel">Fachartikel</a>
				<a href="#kontakt" class="hd-cta">Kontakt</a>
				<a href="/en" class="hd-lang" lang="en" aria-label="Switch to English">EN</a>
			</nav>
		</div>
	</header>

	<main>
		<!-- HERO -->
		<section class="hero">
			<div class="hero-bg" aria-hidden="true"></div>
			<div class="pc-container hero-inner">
				<div class="hero-copy">
					<div class="eyebrow pc-mono"><span class="bar"></span>KI-Automatisierungs-Engineer · DACH · Remote</div>
					<h1>
						Alexander Ohl<br />
						<span class="yellow">— Ich baue Systeme, die für Sie arbeiten.</span>
					</h1>
					<p class="lede">
						Gründer von <a href="https://www.pragma-code.de/" target="_blank" rel="noopener">Pragma-Code</a> mit <strong>15+ Jahren Erfahrung</strong>:
						KI-Automatisierung, moderne Webentwicklung,
						SEO &amp; GEO und E-Commerce — vom Konzept bis zum messbaren Ergebnis.
					</p>
					<div class="hero-tags">
						{services.map(s => (
							<a class="tag" href={s.url} target="_blank" rel="noopener noreferrer" title={`${s.label} bei Pragma-Code`}><span class="dot"></span>{s.label}</a>
