---

<Layout
	title="Alexander Ohl | KI-Automatisierungs-Engineer & Full-Stack-Entwickler"
	description="Alexander Ohl, KI-Automatisierungs-Engineer, Gründer von Pragma-Code: 15+ Jahre KI-Automatisierung, Webentwicklung, SEO/GEO und E-Commerce im DACH-Raum."
>
	<Fragment slot="head">
		<link rel="preload" as="image" href="/assets/alexander-ohl-buero-1200.webp" imagesrcset="/assets/alexander-ohl-buero-800.webp 800w, /assets/alexander-ohl-buero-1200.webp 1200w, /assets/alexander-ohl-buero-1600.webp 1600w" imagesizes="(max-width: 1200px) 100vw, 1104px" fetchpriority="high" />
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
	</Fragment>

	<!-- HEADER -->
	<header class="hd">
		<div class="pc-container hd-inner">
			<a class="hd-logo" href="/" aria-label="alexander@ohl:~$ — Startseite von Alexander Ohl">
				<span class="prompt">alexander@ohl</span><span class="tilde">:~$</span><span class="caret" aria-hidden="true"></span>
			</a>
			<nav class="hd-nav" aria-label="Hauptnavigation">
				<a href="#expertise">Expertise</a>
				<a href="#prinzipien">Prinzipien</a>
				<a href="#werdegang">Werdegang</a>
				<a href="#referenzen">Referenzen</a>
				<a href="#maschinenraum">Maschinenraum</a>
				<a href="/blog">Blog</a>
				<a href="#fachartikel">Fachartikel</a>
				<a href="#kontakt" class="hd-cta">Kontakt</a>
				<a href="/en" class="hd-lang" lang="en" aria-label="Switch to English">EN</a>
				<button type="button" class="hd-menu-btn" popovertarget="hd-menu" aria-label="Menü"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path class="i-open" d="M4 7h16M4 12h16M4 17h16" /><path class="i-close" d="M6 6l12 12M18 6L6 18" /></svg></button>
			</nav>
		</div>
		<div id="hd-menu" class="hd-menu" popover>
			<nav aria-label="Abschnitte">
				<a href="#expertise">Expertise</a>
				<a href="#prinzipien">Prinzipien</a>
				<a href="#werdegang">Werdegang</a>
				<a href="#referenzen">Referenzen</a>
				<a href="#maschinenraum">Maschinenraum</a>
				<a href="/blog">Blog</a>
				<a href="#fachartikel">Fachartikel</a>
			</nav>
		</div>
	</header>

	<script>
		// Mobiles Menü: nach Auswahl eines Abschnitts schließen — ein Popover
		// schließt sonst erst beim Tippen daneben.
		const hdMenu = document.getElementById('hd-menu');
		hdMenu?.querySelectorAll('a').forEach(a => {
			a.addEventListener('click', () => hdMenu.hidePopover?.());
		});
	</script>

	<main>
		<!-- HERO -->
		<section class="hero">
			<div class="hero-bg" aria-hidden="true"></div>
			<div class="pc-container hero-inner">
				<div class="hero-copy">
					<div class="eyebrow pc-mono"><span class="bar"></span>KI-Automatisierungs-Engineer · DACH · Remote</div>
					<h1>
						Alexander Ohl<br />
						<span class="yellow">— Ich baue Systeme, die für Sie arbeiten.</span>
					</h1>
					<p class="lede">
						Gründer von <a href="https://www.pragma-code.de/" target="_blank" rel="noopener">Pragma-Code</a> mit <strong>15+ Jahren Erfahrung</strong>:
						KI-Automatisierung, moderne Webentwicklung,
						SEO &amp; GEO und E-Commerce — vom Konzept bis zum messbaren Ergebnis.
					</p>
					<div class="hero-tags">
						{services.map(s => (
							<a class="tag" href={s.url} target="_blank" rel="noopener noreferrer" title={`${s.label} bei Pragma-Code`}><span class="dot"></span>{s.label}</a>
						))}
					</div>
					<div class="hero-ctas">
						<a class="btn-primary" href="https://calendly.com/pragma-code-info/discovery-call" target="_blank" rel="noopener">Discovery-Call buchen</a>
						<a class="btn-ghost" href="#kontakt">Projekt anfragen</a>
						<a class="btn-ghost" href="https://www.linkedin.com/in/alexander-ohl/" target="_blank" rel="noopener">LinkedIn ↗</a>
					</div>
				</div>

				<!-- Interactive Terminal card -->
				<div class="term" role="region" aria-label="Terminal: whoami — Alexander Ohl">
					<div class="term-bar">
						<span class="tdot red"></span><span class="tdot ylw"></span><span class="tdot grn"></span>
						<span class="term-title pc-mono">alexander@ohl — zsh</span>
					</div>
					<div class="term-body" id="term-container" onclick="document.getElementById('term-input')?.focus();">
						<div id="term-typing" class="term-output" aria-live="polite"></div>
						<div id="term-history"></div>
						<form class="term-prompt-row" id="term-form" onsubmit="return false;">
							<label for="term-input" class="p pc-mono">alexander@ohl ~ % </label>
							<input
								type="text"
								id="term-input"
								class="term-cli-input"
								autocomplete="off"
								spellcheck="false"
								aria-label="Terminal-Befehl eingeben (z.B. help, whoami, git log, skills, call)"
								placeholder="help eingeben..."
							/>
						</form>
					</div>
					<div class="term-chips" aria-label="Schnellbefehle">
						<span class="term-chips-label pc-mono">Befehle:</span>
						<button type="button" class="term-chip" data-cmd="help">help</button>
