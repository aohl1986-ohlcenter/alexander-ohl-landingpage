const ticker = [...stack, ...stack];

// Pragma-Code-Leistungsseiten, passend zu den vier Expertise-Feldern.
const services: { label: string; url: string }[] = [
	{ label: 'KI-Automatisierung', url: 'https://www.pragma-code.de/ki-automatisierung' },
	{ label: 'Webentwicklung', url: 'https://www.pragma-code.de/webentwicklung' },
	{ label: 'SEO & GEO', url: 'https://www.pragma-code.de/seo-content' },
	{ label: 'E-Commerce', url: 'https://www.pragma-code.de/e-commerce' },
];

// 4 unverrückbare Arbeits- und Architekturprinzipien
const principles: { num: string; title: string; desc: string }[] = [
	{
		num: '01',
		title: 'Kein Vendor Lock-in (Open-Source-First)',
		desc: 'Offene Standards, n8n, Next.js, Astro, PostgreSQL und saubere REST-APIs. Sie behalten zu jedem Zeitpunkt 100 % Eigentum und volle Kontrolle über Code, Workflows und Daten.'
	},
	{
		num: '02',
		title: 'Messbarer ROI statt Hype',
		desc: 'Keine theoretischen Spielereien. Jedes KI-Projekt und jede Optimierung wird an greifbaren Kennzahlen gemessen: eingesparte Arbeitsstunden, qualifizierte Leads und messbare Zitate.'
	},
	{
		num: '03',
		title: 'Radikale Performance & Core Web Vitals',
		desc: 'Sub-Sekunden-Ladezeiten, schlanker Code und perfekte Lighthouse-Werte (100/100). Schnelligkeit verbessert nachweislich Conversion Rates und Google-Rankings.'
	},
	{
		num: '04',
		title: 'DSGVO & Datensouveränität (DACH-Hosting)',
		desc: 'Strikte Einhaltung europäischer Datenschutzstandards (DSGVO, EU AI Act). Optionale Self-Hosted & On-Premise LLM-Setups für hochsensible Unternehmensdaten.'
	}
];

// orgUrl: Firmenwebseite der jeweiligen Station (Vertrauens-/E-E-A-T-Signal).
const timeline: { year: string; role: string; org: string; orgUrl?: string; text: string }[] = [
	{ year: '2024', role: 'Gründer & KI-Automatisierungs-Engineer', org: 'Pragma-Code', orgUrl: 'https://www.pragma-code.de/', text: 'IT-Beratung für den Mittelstand: KI-Automatisierung (RAG, n8n), Full-Stack-Webentwicklung, SEO und E-Commerce.' },
	{ year: '2023', role: 'PPC Manager / User Acquisition', org: 'Next Choice Agency', orgUrl: 'https://next-choice.de/', text: 'Paid Media und datengetriebene Funnel-Optimierung. Mit Studio 360° Betreuung von Agenturkunden — u. a. des Alando in Osnabrück (Hotel, Bar & Event-Location).' },
	{ year: '2020', role: 'Gründer Digitalagentur', org: 'Studio 360°', text: 'Internationale Digitalagentur für Web Development und Online-Marketing.' },
	{ year: '2018', role: 'IT-Freelancer', org: 'Freiberuflich · Remote', text: 'Remote-Projekte in IT, Web, SEO und Online-Marketing für Kunden in Deutschland — bis zu sieben davon parallel betreut.' },
	{ year: '2016', role: 'Gründer & Managing Director', org: 'OHLcenter EDV', text: 'Eigene Web- und IT-Agentur: Webgestaltung, Online-Marketing, SEO, Google- & Meta-Ads, CRM-Integration, Vertriebsautomatisierung.' },
	{ year: '2013', role: 'Marketing Manager', org: 'Netrise Solution GmbH & Co. KG', text: 'Aufbau des Vertriebs, Im- und Export von Cisco-, HP- und Juniper-Systemen.' },
	{ year: '2012', role: 'Systemadministrator', org: 'Jüdische Gemeinde Osnabrück K.d.ö.R.', orgUrl: 'https://jg-osnabrueck.de/', text: 'Verantwortung für die gesamte IT-Infrastruktur: IT-Schulungsraum mit 20 PCs, Glasfaseranschluss, Mitgliederdatenbank, NAS-Server, flächendeckende Vernetzung.' },
	{ year: '2010', role: 'Elektroniker für Automatisierungstechnik', org: 'EST GmbH', orgUrl: 'https://est.de/', text: 'Aufbau und Inbetriebnahme von Automatisierungs- und Steuerungstechnik.' },
	{ year: '2009', role: 'IT-Systemadministrator', org: 'KiKxxl GmbH', orgUrl: 'https://kikxxl.de/', text: 'Betreuung und Wartung der IT-Systeme im laufenden Betrieb — erste berufliche Station.' },
	{ year: '2005', role: 'Soldat auf Zeit (SaZ 4)', org: 'Deutsche Marine · Wilhelmshaven', orgUrl: 'https://www.bundeswehr.de/de/organisation/marine', text: 'Dienst an Bord der Fregatte „Bayern“ (F217).' },
];

const education: { year: string; title: string; org: string }[] = [
	{ year: '2013', title: 'Mechatronik-Studium', org: 'Hochschule Osnabrück' },
	{ year: '2010–2013', title: 'Abitur (2. Bildungsweg)', org: 'Abendgymnasium Sophie Scholl' },
	{ year: '2004', title: 'Berufsfachschule Informatik', org: 'BBS Bersenbrück' },
	{ year: '2004', title: 'Realschulabschluss', org: 'Realschule Neuenkirchen' },
];

// `git log` im Hero-Terminal: dieselben Stationen als Commit-Historie
const gitCommits = werdegangCommits(timeline, education);

// Werdegang als Kapitel, chronologisch. Stationen kommen aus `timeline` (eine Quelle),
// die Schulstationen von 2004 aus `education`. Bildunterschriften nur mit belegten Fakten
// (Datum aus den Kamera-Metadaten, Ort aus dem Dateinamen bzw. vom Nutzer).
const stationsBetween = (from: number, to: number) => timeline.filter(t => +t.year >= from && +t.year <= to).reverse();
const careerChapters: CareerChapter[] = [
	{
		num: '01', span: 'bis 2004', title: 'Anfänge',
		text: 'Als Jugendlicher nach Deutschland gekommen, direkt in die achte Klasse eingestiegen und den Realschulabschluss in zwei Jahren geschafft.',
		photos: [
			{ file: 'alexander-ohl-anfaenge-2000er', width: 960, height: 720, alt: 'Alexander Ohl als Schüler (2002/03) am Schreibtisch mit Röhrenmonitor und Laptop', caption: '2002/03 · Röhrenmonitor, Laptop, Poker-Hose' },
		],
		items: education.filter(e => e.year === '2004').reverse().map(e => ({ year: e.year, role: e.title, org: e.org })),
	},
	{
		num: '02', span: '2005–2009', title: 'Marine',
		text: 'Vier Jahre Soldat auf Zeit bei der Deutschen Marine.',
		photos: [
			{ file: 'alexander-ohl-marine-2006-kammer', width: 960, height: 720, alt: 'Alexander Ohl 2006 als Soldat der Deutschen Marine in weißer Uniform, Kammer eines Wohnschiffs', caption: 'Oktober 2006 · Wohnschiff, solange die „Bayern“ in der Werft lag' },
			{ file: 'alexander-ohl-marine-2007-abc-uebung', width: 960, height: 1280, alt: 'Alexander Ohl 2007 mit ABC-Schutzmaske bei einer Gefechtsübung auf der Fregatte „Bayern“', caption: 'Januar 2007 · Gefechtsübung auf der „Bayern“', position: '50% 35%' },
			{ file: 'alexander-ohl-marine-2009-bruecke', width: 960, height: 720, alt: 'Alexander Ohl 2009 am Steuerrad auf der Brücke eines Museumszerstörers', caption: 'Januar 2009 · Brücke eines Zerstörers im Museum', position: '40% 50%' },
		],
		items: stationsBetween(2005, 2008),
	},
	{
		num: '03', span: '2009–2013', title: 'Technik',
		text: 'Vom Serverraum in den Schaltschrank und wieder zurück — und nebenher das Abitur auf dem zweiten Bildungsweg.',
		photos: [
			{ file: 'alexander-ohl-technik-2010-schaltschrank', width: 960, height: 720, alt: 'Alexander Ohl 2010 als Elektroniker für Automatisierungstechnik bei EST, Arbeit am Schaltschrank', caption: 'November 2010 · am Schaltschrank bei EST' },
		],
		missing: 'Der IT-Schulungsraum der Jüdischen Gemeinde (2012) — ohne Personen im Bild und nur mit Zustimmung der Gemeinde.',
		items: stationsBetween(2009, 2012),
	},
	{
		num: '04', span: '2013–heute', title: 'Unternehmer',
		text: 'Erst Vertrieb, dann eigene Agenturen, Freelancing und Agenturarbeit — bis zur Gründung von Pragma-Code. Gearbeitet habe ich dabei fast immer remote, am Laptop: im Café, im Hotel, unterwegs.',
		photos: [
			{ file: 'alexander-ohl-unternehmer-2024-arbeitsplatz', width: 960, height: 720, alt: 'Alexander Ohl, Gründer von Pragma-Code, 2024 an seinem Arbeitsplatz mit Laptop und Monitor', caption: 'Mai 2024 · Gründungsjahr von Pragma-Code', position: '30% 50%' },
			{ file: 'alexander-ohl-unternehmer-2014-hardwarelager', width: 960, height: 720, alt: 'Hardware-Lager mit Netzwerkschrank und Versandkartons, 2014 — Foto von Alexander Ohl', caption: 'Juli 2014 · Hardware-Lager mit Netzwerkschrank' },
			{ file: 'alexander-ohl-unternehmer-2014-laptop-zerlegt', width: 960, height: 720, alt: 'Zerlegter Laptop mit ausgebautem Mainboard und Werkzeug, 2014 — Foto von Alexander Ohl', caption: 'April 2014 · Laptop in Einzelteilen' },
		],
		items: stationsBetween(2013, 2099),
	},
];

// `metric` nur setzen, wenn die Zahl belegt ist (GSC-Export, Tracker-Messung).
// Keine geschätzten oder gerundeten Werte — lieber kein Badge als eine erfundene Zahl.
const references: { url?: string; host: string; name: string; meta: string; text: string; metric?: string }[] = [
	{ url: 'https://esentrans.de/', host: 'esentrans.de', name: 'EsenTrans', meta: 'Umzugsunternehmen · Würzburg', metric: '+111 % organische Klicks in 3 Monaten', text: 'Eigenes WordPress-Plugin entwickelt, das strukturierte Daten (Schema.org/JSON-LD) automatisiert auf eine Vielzahl von Städte-Landingpages ausrollt. Ergebnis über die Google Search Console belegt.' },
	{ host: 'Beratungsmandat', name: 'Entitäts-Sichtbarkeit in KI-Antworten', meta: 'Personal Brand · Entity-SEO & GEO', metric: '+30 % KI-Zitationen in 30 Tagen', text: 'Namens- und Entitätsoptimierung für einen hochrangigen Berater: Landingpage mit strukturierten Daten, konsistente Entitätssignale, laufendes Monitoring über den eigenen Citation-Tracker.' },
	{ url: 'https://www.pragma-code.de/ki-sichtbarkeits-monitoring', host: 'pragma-code.de', name: 'AI-Citation-Tracker', meta: 'Eigenes SaaS-Produkt · live im Kundeneinsatz', text: 'Multi-Tenant-SaaS, das misst, ob und wie eine Marke in LLM-Antworten zitiert wird — von der Idee bis zum Betrieb eigenständig gebaut. Next.js, Supabase, Gemini API.' },
	{ url: 'https://shooting-solutions.de/', host: 'shooting-solutions.de', name: 'Shooting Solutions', meta: 'Schießsport & Training · rund 300 Produkte', text: 'Sechs Monate SEO-Sprint: Backlink-Aufbau, technisches SEO, Local SEO und redaktionelle Blogbeiträge.' },
	{ url: 'https://www.imkerpur.de/lp/', host: 'imkerpur.de/lp', name: 'ImkerPur', meta: 'Online-Shop · Honig & Imkerei', text: 'JTL-Shop um SEO-optimierte Produkt- und Landingpages erweitert, Sichtbarkeit im organischen Suchkanal ausgebaut.' },
	{ url: 'https://www.n-w-reisemobile.de/', host: 'n-w-reisemobile.de', name: 'N&W Reisemobile', meta: 'Wohnmobilvermietung · Bad Essen', text: 'Ganzheitlicher digitaler Neuauftritt: Responsive Website, SEO-Optimierung und Social-Media-Präsenz für spürbar mehr Buchungsanfragen.' },
	{ url: 'https://xn--physiotherapie-osnabrck-wpc.com/', host: 'physiotherapie-osnabrück.com', name: 'Physiotherapie Osnabrück', meta: 'Praxis für Physiotherapie · Osnabrück', text: 'Neugestaltung der Webpräsenz, Local SEO und Social-Media-Auftritt: deutliche Steigerung der Online-Sichtbarkeit und der Terminanfragen von Patienten.' },
	{ url: 'https://k-kbau.de/', host: 'k-kbau.de', name: 'K&K Bau GbR', meta: 'Bauunternehmen · Hoch-/Stahlbetonbau', text: 'Komplette Webpräsenz konzipiert, gebaut und anschließend SEO-optimiert.' },
	{ url: 'https://www.alando-palais.de/', host: 'alando-palais.de', name: 'Alando Palais', meta: 'Hotel · Bar · Event-Location · Osnabrück', text: 'Aufwertung der Online-Präsenz in Zusammenarbeit mit der Agentur Next Choice — Google-Business-Profil und Reputationsmanagement.' },
	{ url: 'https://www.kasinopark.com/', host: 'kasinopark.com', name: 'Kasinopark', meta: 'Gesellschaftshaus · Georgsmarienhütte', text: 'Mehrjährige Betreuung: Webentwicklung, Online-Präsenz, Online-Marketing und SEO.' },
	{ url: 'https://yms-osnabrueck.de/', host: 'yms-osnabrueck.de', name: 'YMS Osnabrück', meta: 'Osnabrück', text: 'Über ein Jahr betreut: SEO, Sichtbarkeit, Google-Business-Profil und Social Media.' },
];

// Ausgewählte Fachartikel & Thought Leadership von Pragma-Code (geprüfte kanonische URLs)
const articles: { tag: string; time: string; year: string; title: string; desc: string; url: string }[] = [
	{
		tag: 'GEO & AI Search',
		time: '8 Min. Lesezeit',
		year: '2026',
		title: 'GEO statt SEO: Der Masterplan für Markenpräsenz in ChatGPT, Claude & Gemini',
		desc: 'Wie KI-Suchmaschinen Kaufentscheidungen steuern und wie Marken durch Entity-SEO, strukturierte Daten und llms.txt zitiert werden.',
		url: 'https://www.pragma-code.de/blog-geo-statt-seo-masterplan-ki-sichtbarkeit'
	},
	{
		tag: 'KI-Automatisierung',
		time: '6 Min. Lesezeit',
		year: '2026',
		title: 'Agentic AI Workflows 2026: Wie KMU mit n8n Prozesse automatisieren',
		desc: 'Der Schritt von einfachen Chatbots zu autonomen Multi-Agenten-Pipelines: Sichere Orchestrierung von Routineaufgaben im Mittelstand.',
		url: 'https://www.pragma-code.de/blog-agentic-ai-workflows-2026'
	},
	{
		tag: 'Web-Architektur',
		time: '7 Min. Lesezeit',
		year: '2026',
		title: 'Make or Buy 2026: Wann sich Custom Code mit Next.js & Astro lohnt',
		desc: 'SaaS-Mietfallen vs. eigener schlanker Code: Wann sich maßgeschneiderte Frontend-Systeme bereits nach wenigen Monaten amortisieren.',
		url: 'https://www.pragma-code.de/blog-make-or-buy-2026-n8n-nextjs'
	}
];

const buildDate = new Date().toISOString();
const personSchema = {
	"@context": "https://schema.org",
	"@type": "ProfilePage",
	"name": "Alexander Ohl — KI-Automatisierungs-Engineer & Full-Stack-Entwickler",
	"url": "https://www.alexander-ohl.com/",
	"inLanguage": "de",
	"dateCreated": "2026-07-09T10:00:00Z",
	"dateModified": buildDate,
	"mainEntity": {
		"@type": "Person",
		"@id": PERSON_ID,
		"name": "Alexander Ohl",
		"jobTitle": jobTitle.de,
		"url": "https://www.alexander-ohl.com/",
		"image": "https://www.alexander-ohl.com/assets/alexander-ohl-portrait.webp",
