					<div class="hero-ctas">
						<a class="btn-primary" href="https://calendly.com/pragma-code-info/discovery-call" target="_blank" rel="noopener">📅 Discovery-Call buchen</a>
						<a class="btn-ghost" href="#kontakt">Projekt anfragen</a>
						<a class="btn-ghost" href="https://www.linkedin.com/in/alexander-ohl/" target="_blank" rel="noopener">LinkedIn ↗</a>
					</div>
				</div>

				<!-- Interactive Terminal card -->
				<div class="term" role="region" aria-label="Interaktives Terminal: whoami — Alexander Ohl">
					<div class="term-bar">
						<span class="tdot red"></span><span class="tdot ylw"></span><span class="tdot grn"></span>
						<span class="term-title pc-mono">alexander@ohl — zsh (interactive)</span>
					</div>
					<div class="term-body" id="term-container" onclick="document.getElementById('term-input')?.focus();">
						<div id="term-history"></div>
						<form class="term-prompt-row" id="term-form" onsubmit="return false;">
							<label for="term-input" class="p pc-mono">alexander@ohl ~ % </label>
							<input
								type="text"
								id="term-input"
								class="term-cli-input"
								autocomplete="off"
								spellcheck="false"
								aria-label="Terminal-Befehl eingeben (z.B. help, whoami, skills, projects, call)"
								placeholder="Tippen Sie z.B. 'help'..."
							/>
						</form>
					</div>
					<div class="term-chips" aria-label="Schnellbefehle">
						<span class="term-chips-label pc-mono">Befehle:</span>
						<button type="button" class="term-chip" data-cmd="help">help</button>
						<button type="button" class="term-chip" data-cmd="whoami">whoami</button>
