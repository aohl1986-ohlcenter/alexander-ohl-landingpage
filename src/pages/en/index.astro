---

<Layout
	title="Alexander Ohl | AI Automation Engineer & Full-Stack Developer"
	description="Alexander Ohl — AI Automation Engineer and founder of Pragma-Code: 15+ years of experience in AI automation, web development, SEO/GEO and e-commerce. Remote in DACH."
	lang="en"
>
	<Fragment slot="head">
		<link rel="preload" as="image" href="/assets/alexander-ohl-buero-1200.webp" fetchpriority="high" />
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
	</Fragment>

	<!-- HEADER -->
	<header class="hd">
		<div class="pc-container hd-inner">
			<a class="hd-logo" href="/en" aria-label="Alexander Ohl — Home">
				<span class="prompt">alexander@ohl</span><span class="tilde">:~$</span><span class="caret" aria-hidden="true"></span>
			</a>
			<nav class="hd-nav" aria-label="Main navigation">
				<a href="#expertise">Expertise</a>
				<a href="#principles">Principles</a>
				<a href="#background">Background</a>
				<a href="#references">References</a>
				<a href="#articles">Articles</a>
				<a href="#contact" class="hd-cta">Contact</a>
				<a href="/" class="hd-lang" lang="de" aria-label="Auf Deutsch wechseln">DE</a>
			</nav>
		</div>
	</header>

	<main>
		<!-- HERO -->
		<section class="hero">
			<div class="hero-bg" aria-hidden="true"></div>
			<div class="pc-container hero-inner">
				<div class="hero-copy">
					<div class="eyebrow pc-mono"><span class="bar"></span>AI Automation Engineer · DACH · Remote</div>
					<h1>
						Alexander Ohl<br />
						<span class="yellow">— I build systems that work for you.</span>
					</h1>
					<p class="lede">
						Founder of <a href="https://www.pragma-code.de/" target="_blank" rel="noopener">Pragma-Code</a> with <strong>15+ years of experience</strong>:
						AI automation, modern web development,
						SEO &amp; GEO and e-commerce — from concept to measurable result.
					</p>
					<div class="hero-tags">
						{services.map(s => (
							<a class="tag" href={s.url} target="_blank" rel="noopener noreferrer" title={`${s.label} at Pragma-Code`}><span class="dot"></span>{s.label}</a>
						))}
					</div>
					<div class="hero-ctas">
						<a class="btn-primary" href="https://calendly.com/pragma-code-info/discovery-call" target="_blank" rel="noopener">📅 Book Discovery Call</a>
						<a class="btn-ghost" href="#contact">Request a project</a>
						<a class="btn-ghost" href="https://www.linkedin.com/in/alexander-ohl/" target="_blank" rel="noopener">LinkedIn ↗</a>
					</div>
				</div>

				<!-- Interactive Terminal card -->
				<div class="term" role="region" aria-label="Interactive Terminal: whoami — Alexander Ohl">
					<div class="term-bar">
						<span class="tdot red"></span><span class="tdot ylw"></span><span class="tdot grn"></span>
						<span class="term-title pc-mono">alexander@ohl — zsh (interactive)</span>
					</div>
					<div class="term-body" id="term-container" onclick="document.getElementById('term-input')?.focus();">
						<div id="term-history"></div>
						<form class="term-prompt-row" id="term-form" onsubmit="return false;">
							<label for="term-input" class="p pc-mono">alexander@ohl ~ % </label>
							<input
								type="text"
								id="term-input"
								class="term-cli-input"
								autocomplete="off"
								spellcheck="false"
								aria-label="Enter terminal command (e.g. help, whoami, skills, projects, call)"
								placeholder="Type e.g. 'help'..."
							/>
						</form>
					</div>
					<div class="term-chips" aria-label="Quick commands">
						<span class="term-chips-label pc-mono">Commands:</span>
						<button type="button" class="term-chip" data-cmd="help">help</button>
						<button type="button" class="term-chip" data-cmd="whoami">whoami</button>
						<button type="button" class="term-chip" data-cmd="skills">skills</button>
						<button type="button" class="term-chip" data-cmd="principles">principles</button>
						<button type="button" class="term-chip" data-cmd="projects">projects</button>
						<button type="button" class="term-chip" data-cmd="call">call</button>
						<button type="button" class="term-chip" data-cmd="clear">clear</button>
					</div>
				</div>
			</div>
		</section>

		<!-- PHOTO BANNER -->
		<section class="photo reveal">
			<div class="pc-container">
				<figure class="photo-frame">
					<img
						src="/assets/alexander-ohl-buero-1200.webp"
						srcset="/assets/alexander-ohl-buero-800.webp 800w, /assets/alexander-ohl-buero-1200.webp 1200w, /assets/alexander-ohl-buero-1600.webp 1600w"
						sizes="(max-width: 1200px) 100vw, 1104px"
						alt="Alexander Ohl in the Pragma Code office"
						width="1634" height="640"
						fetchpriority="high"
					/>
					<figcaption class="photo-strip">
						<span class="live"><span class="live-dot"></span>Available for projects</span>
						<span class="photo-meta">Alexander Ohl · Founder, Pragma-Code</span>
						<span class="photo-meta">DACH · Remote</span>
					</figcaption>
				</figure>
			</div>
		</section>

		<!-- STATS -->
		<section class="stats reveal" aria-label="Metrics">
			<div class="pc-container stats-inner">
				<div class="stat"><div class="num">15<span>+</span></div><div class="lab">Years of experience</div></div>
				<div class="stat"><div class="num">40<span>+</span></div><div class="lab">Client projects</div></div>
				<div class="stat"><div class="num">3</div><div class="lab">Languages fluent</div></div>
				<div class="stat"><div class="num">&lt;24<span>h</span></div><div class="lab">Response time</div></div>
			</div>
		</section>

		<!-- TECH TICKER -->
		<div class="ticker" aria-hidden="true">
			<div class="ticker-track">
				{ticker.map(t => t.url
					? <a class="ticker-item" href={t.url} target="_blank" rel="noopener noreferrer" tabindex="-1">{t.label}</a>
					: <span class="ticker-item">{t.label}</span>
				)}
			</div>
		</div>

		<!-- 01 — EXPERTISE -->
		<section class="sec" id="expertise">
			<div class="pc-container">
				<div class="sec-eyebrow pc-mono">01 — Expertise</div>
				<h2 class="sec-title">How I help businesses move forward</h2>
				<div class="cards">
					<article class="card reveal">
						<div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="9" width="16" height="11" rx="2.5"/><path d="M12 9V5"/><circle cx="12" cy="3.6" r="1.3"/><path d="M2 13v3M22 13v3"/><circle cx="9" cy="14" r="1"/><circle cx="15" cy="14" r="1"/><path d="M9.5 17.5h5"/></svg></div>
						<h3>AI Automation</h3>
						<p>RAG pipelines, n8n workflows and autonomous AI agents that take over routine processes — securely integrated into existing tech stacks.</p>
						<div class="card-chips"><span>RAG</span><span>n8n</span><span>Agents</span></div>
						<a class="card-cta" href="https://www.pragma-code.de/en/ai-automation" target="_blank" rel="noopener noreferrer">See this service at Pragma-Code <span aria-hidden="true">↗</span></a>
					</article>
					<article class="card reveal">
						<div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 7l-5 5 5 5"/><path d="M16 7l5 5-5 5"/><path d="M13.5 5l-3 14"/></svg></div>
						<h3>Web Development</h3>
						<p>Fast, maintainable websites and applications with React, Next.js and Astro — built with top performance and Core Web Vitals from day one.</p>
						<div class="card-chips"><span>React</span><span>Next.js</span><span>Astro</span></div>
						<a class="card-cta" href="https://www.pragma-code.de/en/web-development" target="_blank" rel="noopener noreferrer">See this service at Pragma-Code <span aria-hidden="true">↗</span></a>
					</article>
					<article class="card reveal">
						<div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.7-4.7"/><path d="M7.6 11.4l1.9-1.9 1.5 1.5 2.6-2.6"/></svg></div>
						<h3>SEO &amp; GEO</h3>
						<p>Technical SEO plus Generative Engine Optimization: structured data, llms.txt and authoritative content that AI search engines cite.</p>
						<div class="card-chips"><span>Schema.org</span><span>llms.txt</span><span>AI Search</span></div>
						<a class="card-cta" href="https://www.pragma-code.de/en/seo-content" target="_blank" rel="noopener noreferrer">See this service at Pragma-Code <span aria-hidden="true">↗</span></a>
					</article>
					<article class="card reveal">
						<div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="19.5" r="1.5"/><circle cx="17.5" cy="19.5" r="1.5"/><path d="M3 4h2l2.2 11h11l1.8-8H6.2"/></svg></div>
						<h3>E-Commerce</h3>
						<p>Online stores that convert: WooCommerce, Shopify and JTL — from high-converting product pages to systematic checkout optimization.</p>
						<div class="card-chips"><span>WooCommerce</span><span>Shopify</span><span>JTL</span></div>
						<a class="card-cta" href="https://www.pragma-code.de/en/e-commerce" target="_blank" rel="noopener noreferrer">See this service at Pragma-Code <span aria-hidden="true">↗</span></a>
					</article>
				</div>
			</div>
		</section>

		<!-- 02 — PRINCIPLES -->
		<section class="sec sec-alt" id="principles">
			<div class="pc-container">
				<div class="sec-eyebrow pc-mono">02 — Principles</div>
				<h2 class="sec-title">How I work: 4 non-negotiable principles</h2>
				<p class="sec-lede">No vendor lock-ins, no AI hype without ROI: My systems are built for long-term autonomy, measurable business outcomes, and radical speed.</p>
				<div class="principles-grid">
					{principles.map(p => (
						<article class="principle-card reveal">
							<div class="principle-num pc-mono">{p.num}</div>
							<h3>{p.title}</h3>
							<p>{p.desc}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- 03 — BACKGROUND -->
		<section class="sec" id="background">
			<div class="pc-container">
				<div class="sec-eyebrow pc-mono">03 — Background</div>
				<h2 class="sec-title">From the engine room to AI systems</h2>
				<p class="sec-lede">From the frigate "Bayern" through hands-on system administration and agency leadership to independent IT engineering — each milestone sharpened the deep architectural thinking behind every project.</p>
				<ol class="tl">
					{timeline.map(item => (
						<li class="tl-item reveal">
							<div class="tl-year pc-mono">{item.year}</div>
							<div class="tl-body">
