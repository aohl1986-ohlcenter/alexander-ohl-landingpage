// Case studies & client projects
const references: { url?: string; host: string; name: string; meta: string; text: string; metric?: string }[] = [
	{ url: 'https://esentrans.de/', host: 'esentrans.de', name: 'EsenTrans', meta: 'Moving company · Würzburg', metric: '+111% organic clicks in 3 months', text: 'Built a custom WordPress plugin that automates Schema.org / JSON-LD structured data rollouts across dozens of city landing pages. Verified via Google Search Console.' },
	{ host: 'Consulting engagement', name: 'Entity Visibility in AI Answers', meta: 'Personal Brand · Entity SEO & GEO', metric: '+30% AI citations in 30 days', text: 'Name and entity optimization for a high-profile consultant: landing page with rich schema, consistent knowledge graph signals, ongoing tracking via custom AI Citation Tracker.' },
	{ url: 'https://www.pragma-code.de/en/ai-visibility-monitoring', host: 'pragma-code.de', name: 'AI Citation Tracker', meta: 'Own SaaS product · live with clients', text: 'Multi-tenant SaaS that measures whether and how a brand is cited in LLM answers — built end to end, from idea to production. Next.js, Supabase, Gemini API.' },
