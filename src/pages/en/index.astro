---
import Layout from '../../layouts/Layout.astro';
import { PERSON_ID, jobTitle, personSameAs, pragmaCodeOrganization } from '../../data/person';
import Maschinenraum from '../../components/Maschinenraum.astro';
import Kundenstimmen from '../../components/Kundenstimmen.astro';
import CareerChapters, { type CareerChapter } from '../../components/CareerChapters.astro';
import { werdegangCommits, jsonForScript } from '../../data/werdegang-git';

// Tech stack: linked to official vendor sites where applicable.
const stack: { label: string; url?: string }[] = [
	{ label: 'React', url: 'https://react.dev/' },
	{ label: 'Next.js', url: 'https://nextjs.org/' },
	{ label: 'Astro', url: 'https://astro.build/' },
	{ label: 'TypeScript', url: 'https://www.typescriptlang.org/' },
	{ label: 'Node.js', url: 'https://nodejs.org/' },
	{ label: 'Python', url: 'https://www.python.org/' },
	{ label: 'PHP', url: 'https://www.php.net/' },
	{ label: 'WordPress', url: 'https://wordpress.org/' },
	{ label: 'WooCommerce', url: 'https://woocommerce.com/' },
	{ label: 'Shopify', url: 'https://www.shopify.com/' },
	{ label: 'JTL-Shop', url: 'https://www.jtl-software.de/' },
	{ label: 'n8n', url: 'https://n8n.io/' },
	{ label: 'RAG' },
	{ label: 'AI Agents' },
	{ label: 'Claude', url: 'https://www.anthropic.com/claude' },
	{ label: 'Gemini', url: 'https://ai.google.dev/' },
	{ label: 'Docker', url: 'https://www.docker.com/' },
	{ label: 'Git', url: 'https://git-scm.com/' },
	{ label: 'SEO' },
	{ label: 'GEO' },
	{ label: 'Schema.org', url: 'https://schema.org/' },
	{ label: 'Bright Data', url: 'https://brightdata.com/' },
	{ label: 'Cloudflare', url: 'https://www.cloudflare.com/' },
	{ label: 'Vercel', url: 'https://vercel.com/' },
	{ label: 'AWS', url: 'https://aws.amazon.com/' },
	{ label: 'Supabase', url: 'https://supabase.com/' },
	{ label: 'Neon', url: 'https://neon.com/' },
	{ label: 'Zapier', url: 'https://zapier.com/' },
	{ label: 'Elementor', url: 'https://elementor.com/' },
	{ label: 'Figma', url: 'https://www.figma.com/' },
	{ label: 'Remotion', url: 'https://www.remotion.dev/' },
	{ label: 'Ahrefs', url: 'https://ahrefs.com/' },
];
const ticker = [...stack, ...stack];

// Pragma-Code service pages (English version).
const services: { label: string; url: string }[] = [
	{ label: 'AI Automation', url: 'https://www.pragma-code.de/en/ai-automation' },
	{ label: 'Web Development', url: 'https://www.pragma-code.de/en/web-development' },
	{ label: 'SEO & GEO', url: 'https://www.pragma-code.de/en/seo-content' },
	{ label: 'E-Commerce', url: 'https://www.pragma-code.de/en/e-commerce' },
];

// 4 non-negotiable engineering & architecture principles
const principles: { num: string; title: string; desc: string }[] = [
	{
		num: '01',
		title: 'No Vendor Lock-in (Open-Source-First)',
		desc: 'Open standards, n8n, Next.js, Astro, PostgreSQL, and clean REST APIs. You maintain 100% ownership and full autonomy over your code, workflows, and data at all times.'
	},
	{
		num: '02',
		title: 'Measurable ROI Over Hype',
		desc: 'No theoretical AI gimmicks. Every automation and engineering project is measured against tangible metrics: saved work hours, qualified leads, and measurable citations.'
	},
	{
		num: '03',
		title: 'Radical Performance & Core Web Vitals',
		desc: 'Sub-second load times, lightweight code, and flawless Lighthouse scores (100/100). Speed directly drives conversion rates and search engine rankings.'
	},
	{
		num: '04',
		title: 'GDPR & Data Sovereignty (DACH Hosting)',
		desc: 'Strict compliance with European data privacy standards (GDPR, EU AI Act). Optional self-hosted and on-premise LLM setups for sensitive corporate data.'
	}
];

// orgUrl: company website of each milestone (E-E-A-T trust signal).
const timeline: { year: string; role: string; org: string; orgUrl?: string; text: string }[] = [
	{ year: '2024', role: 'Founder & AI Automation Engineer', org: 'Pragma-Code', orgUrl: 'https://www.pragma-code.de/en', text: 'IT consulting for SMEs: AI automation (RAG, n8n), full-stack web development, SEO and e-commerce.' },
	{ year: '2023', role: 'PPC Manager / User Acquisition', org: 'Next Choice Agency', orgUrl: 'https://next-choice.de/', text: 'Paid media and data-driven funnel optimization. Supported agency clients alongside Studio 360° — including Alando in Osnabrück (hotel, bar & event venue).' },
	{ year: '2020', role: 'Digital Agency Founder', org: 'Studio 360°', text: 'International digital agency for web development and online marketing.' },
	{ year: '2018', role: 'IT Freelancer', org: 'Freelance · Remote', text: 'Remote projects in IT, web, SEO and marketing for clients across Germany — managing up to seven concurrently.' },
	{ year: '2016', role: 'Founder & Managing Director', org: 'OHLcenter EDV', text: 'Own web and IT agency: Web design, online marketing, SEO, Google & Meta Ads, CRM integration and sales automation.' },
	{ year: '2013', role: 'Marketing Manager', org: 'Netrise Solution GmbH & Co. KG', text: 'Built up sales operations, import and export of Cisco, HP and Juniper systems.' },
	{ year: '2012', role: 'System Administrator', org: 'Jewish Community of Osnabrück', orgUrl: 'https://jg-osnabrueck.de/', text: 'Full IT infrastructure ownership: training room with 20 PCs, fiber-optic line, member database, NAS servers, network infrastructure.' },
	{ year: '2010', role: 'Automation Electronics Technician', org: 'EST GmbH', orgUrl: 'https://est.de/', text: 'Assembly and commissioning of automation and control systems.' },
	{ year: '2009', role: 'IT Systems Administrator', org: 'KiKxxl GmbH', orgUrl: 'https://kikxxl.de/', text: 'Maintenance and monitoring of operational IT systems — first professional station.' },
	{ year: '2005', role: 'Enlisted Sailor (4 years)', org: 'German Navy · Wilhelmshaven', orgUrl: 'https://www.bundeswehr.de/de/organisation/marine', text: 'Service aboard the frigate "Bayern" (F217).' },
];

const education: { year: string; title: string; org: string }[] = [
	{ year: '2013', title: 'Mechatronics studies', org: 'Osnabrück University of Applied Sciences' },
	{ year: '2010–2013', title: 'Abitur (second-chance education)', org: 'Abendgymnasium Sophie Scholl' },
	{ year: '2004', title: 'Vocational College of Computer Science', org: 'BBS Bersenbrück' },
	{ year: '2004', title: 'Secondary School Certificate', org: 'Realschule Neuenkirchen' },
];

// `git log` in the hero terminal: the same stations as a commit history
const gitCommits = werdegangCommits(timeline, education);

// Background as chapters, chronological — mirrors the German page (src/pages/index.astro).
// Stations come from `timeline`, the 2004 school stations from `education`.
const stationsBetween = (from: number, to: number) => timeline.filter(t => +t.year >= from && +t.year <= to).reverse();
const careerChapters: CareerChapter[] = [
	{
		num: '01', span: 'until 2004', title: 'Beginnings',
		text: 'Came to Germany as a teenager, went straight into eighth grade and finished secondary school in two years.',
		photos: [
			{ file: 'alexander-ohl-anfaenge-2000er', width: 960, height: 720, alt: 'Alexander Ohl as a school student (2002/03) at his desk with a CRT monitor and laptop', caption: '2002/03 · CRT monitor, laptop, poker-card trousers' },
		],
		items: education.filter(e => e.year === '2004').reverse().map(e => ({ year: e.year, role: e.title, org: e.org })),
	},
	{
		num: '02', span: '2005–2009', title: 'Navy',
		text: 'Four years as an enlisted sailor in the German Navy.',
		photos: [
			{ file: 'alexander-ohl-marine-2006-kammer', width: 960, height: 720, alt: 'Alexander Ohl in 2006 as a German Navy sailor in white uniform, cabin of an accommodation ship', caption: 'October 2006 · accommodation ship while the “Bayern” was in the shipyard' },
			{ file: 'alexander-ohl-marine-2007-abc-uebung', width: 960, height: 1280, alt: 'Alexander Ohl in 2007 wearing a CBRN gas mask during a combat drill aboard the frigate “Bayern”', caption: 'January 2007 · combat drill aboard the “Bayern”', position: '50% 35%' },
			{ file: 'alexander-ohl-marine-2009-bruecke', width: 960, height: 720, alt: 'Alexander Ohl in 2009 at the helm on the bridge of a museum destroyer', caption: 'January 2009 · bridge of a museum destroyer', position: '40% 50%' },
		],
		items: stationsBetween(2005, 2008),
	},
	{
		num: '03', span: '2009–2013', title: 'Technology',
		text: 'From the server room to the control cabinet and back — while earning the Abitur at evening school.',
		photos: [
			{ file: 'alexander-ohl-technik-2010-schaltschrank', width: 960, height: 720, alt: 'Alexander Ohl in 2010 as an automation electronics technician at EST, working on a control cabinet', caption: 'November 2010 · at the control cabinet at EST' },
		],
		missing: 'The IT training room of the Jewish Community (2012) — no people in the picture, and only with the community’s consent.',
		items: stationsBetween(2009, 2012),
	},
	{
		num: '04', span: '2013–today', title: 'Entrepreneur',
		text: 'First sales, then my own agencies, freelancing and agency work — up to founding Pragma-Code. Almost always remote, on a laptop: in cafés, in hotels, on the road.',
		photos: [
			{ file: 'alexander-ohl-unternehmer-2024-arbeitsplatz', width: 960, height: 720, alt: 'Alexander Ohl, founder of Pragma-Code, in 2024 at his workspace with laptop and monitor', caption: 'May 2024 · founding year of Pragma-Code', position: '30% 50%' },
			{ file: 'alexander-ohl-unternehmer-2014-hardwarelager', width: 960, height: 720, alt: 'Hardware storeroom with network rack and shipping boxes, 2014 — photo by Alexander Ohl', caption: 'July 2014 · hardware storeroom with network rack' },
			{ file: 'alexander-ohl-unternehmer-2014-laptop-zerlegt', width: 960, height: 720, alt: 'Disassembled laptop with the mainboard removed and tools, 2014 — photo by Alexander Ohl', caption: 'April 2014 · a laptop in pieces' },
		],
		items: stationsBetween(2013, 2099),
	},
];

// Case studies & client projects
const references: { url?: string; host: string; name: string; meta: string; text: string; metric?: string }[] = [
	{ url: 'https://esentrans.de/', host: 'esentrans.de', name: 'EsenTrans', meta: 'Moving company · Würzburg', metric: '+111% organic clicks in 3 months', text: 'Built a custom WordPress plugin that automates Schema.org / JSON-LD structured data rollouts across dozens of city landing pages. Verified via Google Search Console.' },
	{ host: 'Consulting engagement', name: 'Entity Visibility in AI Answers', meta: 'Personal Brand · Entity SEO & GEO', metric: '+30% AI citations in 30 days', text: 'Name and entity optimization for a high-profile consultant: landing page with rich schema, consistent knowledge graph signals, ongoing tracking via custom AI Citation Tracker.' },
	{ url: 'https://www.pragma-code.de/en/ai-visibility-monitoring', host: 'pragma-code.de', name: 'AI Citation Tracker', meta: 'Own SaaS product · live with clients', text: 'Multi-tenant SaaS that measures whether and how a brand is cited in LLM answers — built end to end, from idea to production. Next.js, Supabase, Gemini API.' },
	{ url: 'https://shooting-solutions.de/', host: 'shooting-solutions.de', name: 'Shooting Solutions', meta: 'Shooting sports & training · ~300 products', text: 'Six-month SEO sprint: Backlink acquisition, technical SEO audits, Local SEO and editorial blog content.' },
	{ url: 'https://www.imkerpur.de/lp/', host: 'imkerpur.de/lp', name: 'ImkerPur', meta: 'Online store · Honey & beekeeping', text: 'Expanded JTL-Shop with SEO-optimized product and landing pages, strengthening visibility across organic search.' },
	{ url: 'https://www.n-w-reisemobile.de/', host: 'n-w-reisemobile.de', name: 'N&W Reisemobile', meta: 'Camper rental · Bad Essen', text: 'Complete digital revamp: Responsive website, search engine optimization and social media presence for a significant boost in booking requests.' },
	{ url: 'https://xn--physiotherapie-osnabrck-wpc.com/', host: 'physiotherapie-osnabrück.com', name: 'Physiotherapie Osnabrück', meta: 'Physiotherapy clinic · Osnabrück', text: 'Website redesign, Local SEO and social media presence: substantial increase in online visibility and patient appointment requests.' },
	{ url: 'https://k-kbau.de/', host: 'k-kbau.de', name: 'K&K Bau GbR', meta: 'Construction company · Structural engineering', text: 'Designed, built and SEO-optimized the entire corporate web presence from scratch.' },
	{ url: 'https://www.alando-palais.de/', host: 'alando-palais.de', name: 'Alando Palais', meta: 'Hotel · Bar · Event venue · Osnabrück', text: 'Upgraded online presence in partnership with Next Choice agency — Google Business profile and active reputation management.' },
	{ url: 'https://www.kasinopark.com/', host: 'kasinopark.com', name: 'Kasinopark', meta: 'Community venue · Georgsmarienhütte', text: 'Multi-year engagement: Web development, online presence, digital marketing and SEO care.' },
	{ url: 'https://yms-osnabrueck.de/', host: 'yms-osnabrueck.de', name: 'YMS Osnabrück', meta: 'Osnabrück', text: 'Over a year of comprehensive support: SEO, online visibility, Google Business optimization and social media.' },
];

// Featured Thought Leadership & Technical Deep-Dives from Pragma-Code (verified canonical URLs)
const articles: { tag: string; time: string; year: string; title: string; desc: string; url: string }[] = [
	{
		tag: 'GEO & AI Search',
		time: '8 min read',
		year: '2026',
		title: 'GEO Instead of SEO: The Masterplan for Brand Visibility in ChatGPT, Claude & Gemini',
		desc: 'How AI answer engines drive purchasing decisions and how brands secure top citations through Entity SEO, Schema markup, and llms.txt.',
		url: 'https://www.pragma-code.de/en/blog-geo-over-seo-masterplan-ai-visibility'
	},
	{
		tag: 'AI Automation',
		time: '6 min read',
		year: '2026',
		title: 'Agentic AI Workflows 2026: How SMEs Automate Business Logic with n8n',
		desc: 'The shift from simple chatbots to autonomous multi-agent pipelines: securely orchestrating business routine workflows for SMEs.',
		url: 'https://www.pragma-code.de/en/blog-agentic-ai-workflows-2026'
	},
	{
		tag: 'Web Architecture',
		time: '7 min read',
		year: '2026',
		title: 'Make or Buy 2026: When Custom Code with Next.js & Astro Outperforms SaaS',
		desc: 'Avoiding SaaS subscription traps: when tailored frontend systems deliver a positive ROI within just a few months.',
		url: 'https://www.pragma-code.de/en/blog-make-or-buy-2026-n8n-nextjs'
	}
];

const buildDate = new Date().toISOString();
const personSchema = {
	"@context": "https://schema.org",
	"@type": "ProfilePage",
	"name": "Alexander Ohl — AI Automation Engineer & Full-Stack Developer",
	"url": "https://www.alexander-ohl.com/en",
	"inLanguage": "en",
	"dateCreated": "2026-07-09T10:00:00Z",
	"dateModified": buildDate,
	"mainEntity": {
		"@type": "Person",
		"@id": PERSON_ID,
		"name": "Alexander Ohl",
		"jobTitle": jobTitle.en,
		"url": "https://www.alexander-ohl.com/en",
		"image": "https://www.alexander-ohl.com/assets/alexander-ohl-portrait.webp",
		"email": "mailto:info@pragma-code.de",
		"sameAs": personSameAs,
		"worksFor": pragmaCodeOrganization,
		"knowsAbout": ["AI Automation", "Web Development", "SEO", "Generative Engine Optimization", "E-Commerce", "React", "Next.js", "Astro", "n8n", "RAG"],
		"knowsLanguage": ["de", "en", "ru"],
		"alumniOf": [
			{ "@type": "EducationalOrganization", "name": "Osnabrück University of Applied Sciences" },
			{ "@type": "EducationalOrganization", "name": "Abendgymnasium Sophie Scholl" }
		]
	}
};
---

<Layout
	title="Alexander Ohl | AI Automation Engineer & Full-Stack Developer"
	description="Alexander Ohl, AI Automation Engineer and founder of Pragma-Code: 15+ years in AI automation, web development, SEO/GEO and e-commerce. Remote across DACH."
	lang="en"
>
	<Fragment slot="head">
		<link rel="preload" as="image" href="/assets/alexander-ohl-buero-1200.webp" imagesrcset="/assets/alexander-ohl-buero-800.webp 800w, /assets/alexander-ohl-buero-1200.webp 1200w, /assets/alexander-ohl-buero-1600.webp 1600w" imagesizes="(max-width: 1200px) 100vw, 1104px" fetchpriority="high" />
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
	</Fragment>

	<!-- HEADER -->
	<header class="hd">
		<div class="pc-container hd-inner">
			<a class="hd-logo" href="/en" aria-label="alexander@ohl:~$ — Home of Alexander Ohl">
				<span class="prompt">alexander@ohl</span><span class="tilde">:~$</span><span class="caret" aria-hidden="true"></span>
			</a>
			<nav class="hd-nav" aria-label="Main navigation">
				<a href="#expertise">Expertise</a>
				<a href="#principles">Principles</a>
				<a href="#background">Background</a>
				<a href="#references">References</a>
				<a href="#engine-room">Engine room</a>
				<a href="#articles">Articles</a>
				<a href="#contact" class="hd-cta">Contact</a>
				<a href="/" class="hd-lang" lang="de" aria-label="Auf Deutsch wechseln">DE</a>
				<button type="button" class="hd-menu-btn" popovertarget="hd-menu" aria-label="Menu"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path class="i-open" d="M4 7h16M4 12h16M4 17h16" /><path class="i-close" d="M6 6l12 12M18 6L6 18" /></svg></button>
			</nav>
		</div>
		<div id="hd-menu" class="hd-menu" popover>
			<nav aria-label="Sections">
				<a href="#expertise">Expertise</a>
				<a href="#principles">Principles</a>
				<a href="#background">Background</a>
				<a href="#references">References</a>
				<a href="#engine-room">Engine room</a>
				<a href="#articles">Articles</a>
			</nav>
		</div>
	</header>

	<script>
		// Mobiles Menü: nach Auswahl eines Abschnitts schließen — ein Popover
		// schließt sonst erst beim Tippen daneben.
		const hdMenu = document.getElementById('hd-menu');
		hdMenu?.querySelectorAll('a').forEach(a => {
			a.addEventListener('click', () => hdMenu.hidePopover?.());
		});
	</script>

	<main>
		<!-- HERO -->
		<section class="hero">
			<div class="hero-bg" aria-hidden="true"></div>
			<div class="pc-container hero-inner">
				<div class="hero-copy">
					<div class="eyebrow pc-mono"><span class="bar"></span>AI Automation Engineer · DACH · Remote</div>
					<h1>
						Alexander Ohl<br />
						<span class="yellow">— I build systems that work for you.</span>
					</h1>
					<p class="lede">
						Founder of <a href="https://www.pragma-code.de/" target="_blank" rel="noopener">Pragma-Code</a> with <strong>15+ years of experience</strong>:
						AI automation, modern web development,
						SEO &amp; GEO and e-commerce — from concept to measurable result.
					</p>
					<div class="hero-tags">
						{services.map(s => (
							<a class="tag" href={s.url} target="_blank" rel="noopener noreferrer" title={`${s.label} at Pragma-Code`}><span class="dot"></span>{s.label}</a>
						))}
					</div>
					<div class="hero-ctas">
						<a class="btn-primary" href="https://calendly.com/pragma-code-info/discovery-call" target="_blank" rel="noopener">Book Discovery Call</a>
						<a class="btn-ghost" href="#contact">Request a project</a>
						<a class="btn-ghost" href="https://www.linkedin.com/in/alexander-ohl/" target="_blank" rel="noopener">LinkedIn ↗</a>
					</div>
				</div>

				<!-- Interactive Terminal card -->
				<div class="term" role="region" aria-label="Interactive Terminal: whoami — Alexander Ohl">
					<div class="term-bar">
						<span class="tdot red"></span><span class="tdot ylw"></span><span class="tdot grn"></span>
						<span class="term-title pc-mono">alexander@ohl — zsh</span>
					</div>
					<div class="term-body" id="term-container" onclick="document.getElementById('term-input')?.focus();">
						<div id="term-typing" class="term-output" aria-live="polite"></div>
						<div id="term-history"></div>
						<form class="term-prompt-row" id="term-form" onsubmit="return false;">
							<label for="term-input" class="p pc-mono">alexander@ohl ~ % </label>
							<input
								type="text"
								id="term-input"
								class="term-cli-input"
								autocomplete="off"
								spellcheck="false"
								aria-label="Enter terminal command (e.g. help, whoami, git log, skills, call)"
								placeholder="type 'help'..."
							/>
						</form>
					</div>
					<div class="term-chips" aria-label="Quick commands">
						<span class="term-chips-label pc-mono">Commands:</span>
						<button type="button" class="term-chip" data-cmd="help">help</button>
						<button type="button" class="term-chip" data-cmd="whoami">whoami</button>
						<button type="button" class="term-chip" data-cmd="git log">git log</button>
						<button type="button" class="term-chip" data-cmd="skills">skills</button>
						<button type="button" class="term-chip" data-cmd="principles">principles</button>
						<button type="button" class="term-chip" data-cmd="projects">projects</button>
						<button type="button" class="term-chip" data-cmd="call">call</button>
						<button type="button" class="term-chip" data-cmd="clear">clear</button>
					</div>
					<script type="application/json" id="term-git" is:inline set:html={jsonForScript(gitCommits)} />
				</div>
			</div>
		</section>

		<!-- PHOTO BANNER -->
		<section class="photo reveal">
			<div class="pc-container">
				<figure class="photo-frame">
					<img
						src="/assets/alexander-ohl-buero-1200.webp"
						srcset="/assets/alexander-ohl-buero-800.webp 800w, /assets/alexander-ohl-buero-1200.webp 1200w, /assets/alexander-ohl-buero-1600.webp 1600w"
						sizes="(max-width: 1200px) 100vw, 1104px"
						alt="Alexander Ohl in the Pragma Code office"
						width="1634" height="640"
						fetchpriority="high"
					/>
					<figcaption class="photo-strip">
						<span class="live"><span class="live-dot"></span>Available for projects</span>
						<span class="photo-meta">Alexander Ohl · Founder, Pragma-Code</span>
						<span class="photo-meta">DACH · Remote</span>
					</figcaption>
				</figure>
			</div>
		</section>

		<!-- STATS -->
		<section class="stats reveal" aria-label="Metrics">
			<div class="pc-container stats-inner">
				<div class="stat"><div class="num">15<span>+</span></div><div class="lab">Years of experience</div></div>
				<div class="stat"><div class="num">40<span>+</span></div><div class="lab">Client projects</div></div>
				<div class="stat"><div class="num">3</div><div class="lab">Languages fluent</div></div>
				<div class="stat"><div class="num">&lt;24<span>h</span></div><div class="lab">Response time</div></div>
			</div>
		</section>

		<!-- TECH TICKER -->
		<div class="ticker" aria-hidden="true">
			<div class="ticker-track" style={`--ticker-count: ${stack.length}`}>
				{ticker.map(t => t.url
					? <a class="ticker-item" href={t.url} target="_blank" rel="noopener noreferrer" tabindex="-1">{t.label}</a>
					: <span class="ticker-item">{t.label}</span>
				)}
			</div>
		</div>

		<!-- 01 — EXPERTISE -->
		<section class="sec" id="expertise">
			<div class="pc-container">
				<div class="sec-eyebrow pc-mono">01 — Expertise</div>
				<h2 class="sec-title">How I help businesses move forward</h2>
				<div class="cards">
					<article class="card reveal">
