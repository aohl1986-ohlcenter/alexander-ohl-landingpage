	{ year: '2012', role: 'System Administrator', org: 'Jewish Community of Osnabrück', orgUrl: 'https://jg-osnabrueck.de/', text: 'Full IT infrastructure ownership: training room with 20 PCs, fiber-optic line, member database, NAS servers, network infrastructure.' },
	{ year: '2010', role: 'Automation Electronics Technician', org: 'EST GmbH', orgUrl: 'https://est.de/', text: 'Assembly and commissioning of automation and control systems.' },
	{ year: '2009', role: 'IT Systems Administrator', org: 'KiKxxl GmbH', orgUrl: 'https://kikxxl.de/', text: 'Maintenance and monitoring of operational IT systems — first professional station.' },
	{ year: '2005', role: 'Enlisted Sailor (4 years)', org: 'German Navy · Wilhelmshaven', orgUrl: 'https://www.bundeswehr.de/de/organisation/marine', text: 'Service aboard the frigate "Bayern" (F217).' },
