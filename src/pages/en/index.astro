	<script>
		// Interactive Hero Terminal with CLI commands, history and quick-chips
		const PROMPT_STR = 'alexander@ohl ~ % ';
		const historyEl = document.getElementById('term-history');
		const inputEl = document.getElementById('term-input') as HTMLInputElement | null;
		const formEl = document.getElementById('term-form');
		const containerEl = document.getElementById('term-container');
		const chips = document.querySelectorAll('.term-chip');

		const cmdHistory: string[] = [];
		let historyIdx = -1;

		const COMMANDS: Record<string, string> = {
			help: `Available commands:
  whoami       - Bio & role overview of Alexander Ohl
  skills       - Tech stack, languages & frameworks
  principles   - 4 core engineering & architecture principles
  projects     - Featured client projects & SaaS products
  call         - Schedule a 30-min discovery call
  pricing      - Packages, fixed prices & retainers
  contact      - Contact options (Email, quote request)
  clear        - Clear terminal screen`,

			whoami: `Alexander Ohl — AI Automation Engineer & Founder of Pragma-Code.
15+ years of practical experience in software architecture, AI automation (n8n, RAG), SEO & GEO, and e-commerce in the DACH region.`,

			skills: `⚡ Tech Stack & Core Competencies:
• Frontend: React, Next.js, Astro, TypeScript, Tailwind CSS
• Backend: Node.js, Python, PHP, REST APIs, SQL, Docker, Git
• AI & Automation: n8n, RAG pipelines, LLM agents, Gemini API, RPA
• Visibility & Commerce: SEO, GEO (Generative Engine Optimization), Shopify, WooCommerce, JTL`,

			principles: `⚙️ 4 Engineering Principles:
1. No Vendor Lock-in (Open-Source-First, 100% data autonomy)
2. Measurable ROI Over Hype (Saved hours, qualified leads & citations)
3. Radical Performance (Sub-second load times, Core Web Vitals 100/100)
4. GDPR & Data Sovereignty (European hosting, on-premise LLMs)`,

			projects: `📁 Featured Client Projects & Case Studies:
• EsenTrans (esentrans.de): Custom WordPress Schema plugin (+111% clicks)
• AI Citation Tracker (pragma-code.de): Multi-tenant SaaS for LLM citations
• ImkerPur (imkerpur.de/lp): JTL-Shop & SEO landing pages
• N&W Reisemobile (n-w-reisemobile.de): Web presence, SEO & social media
• Physiotherapie Osnabrück: Website & local SEO
• Shooting Solutions (shooting-solutions.de): 6-month SEO sprint`,

			call: `📅 Book a free 30-min discovery call with Alexander:
👉 https://calendly.com/pragma-code-info/discovery-call`,

			pricing: `💰 Packages & Pricing at Pragma-Code:
• AI Visibility Monitoring: from €149/month (cancel monthly)
• Monthly Retainers (Web/SEO/AI): from €390/month
• Fixed-Price Projects & Audits: from €690
Overview: https://www.pragma-code.de/en/packages-pricing`,

			contact: `📬 Get in touch:
• Email: info@pragma-code.de
• Project inquiry: https://www.pragma-code.de/projektanfrage
• LinkedIn: https://www.linkedin.com/in/alexander-ohl/`,

			sudo: `zsh: permission denied: Nice try! You already have full developer access to explore the site.`
		};

		function appendOutput(cmd: string, output: string) {
			if (!historyEl) return;
			const item = document.createElement('div');
			item.className = 'term-entry';
			item.innerHTML = `<div class="term-line"><span class="p pc-mono">${PROMPT_STR}</span><span class="cmd-text">${escapeHtml(cmd)}</span></div>${output ? `<div class="o pc-mono">${escapeHtml(output)}</div>` : ''}`;
			historyEl.appendChild(item);
			if (containerEl) {
				containerEl.scrollTop = containerEl.scrollHeight;
			}
		}

		function escapeHtml(str: string) {
			return str
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;');
		}

		function executeCommand(rawCmd: string) {
			const cmd = rawCmd.trim().toLowerCase();
			if (!cmd) return;

			cmdHistory.push(rawCmd);
			historyIdx = cmdHistory.length;

			if (cmd === 'clear') {
				if (historyEl) historyEl.innerHTML = '';
				return;
			}

			if (cmd in COMMANDS) {
				appendOutput(rawCmd, COMMANDS[cmd]);
			} else if (cmd === 'stack') {
				appendOutput(rawCmd, COMMANDS['skills']);
			} else if (cmd === 'refs' || cmd === 'cases') {
				appendOutput(rawCmd, COMMANDS['projects']);
			} else if (cmd === 'book' || cmd === 'appointment') {
				appendOutput(rawCmd, COMMANDS['call']);
			} else if (cmd === 'mail' || cmd === 'email') {
				appendOutput(rawCmd, COMMANDS['contact']);
			} else {
				appendOutput(rawCmd, `zsh: command not found: ${cmd}. Type 'help' for available commands.`);
			}
		}

		// Initial greeting lines
		const initialLines = [
			{ cmd: 'whoami', out: 'Alexander Ohl — IT Generalist & AI Engineer' },
			{ cmd: 'cat stack.txt', out: 'Web · SEO/GEO · AI Automation · E-Commerce' },
			{ cmd: './verfuegbarkeit.sh', out: '● available for projects — DACH · Remote' }
		];

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (reduced) {
			initialLines.forEach(l => appendOutput(l.cmd, l.out));
		} else {
			(async () => {
				const sleep = (ms: number) => new Promise(r => setTimeout(r, ms));
				for (const l of initialLines) {
					appendOutput(l.cmd, l.out);
					await sleep(180);
				}
			})();
		}

		// Event listener for form & input
		formEl?.addEventListener('submit', (e) => {
			e.preventDefault();
			if (!inputEl) return;
			const val = inputEl.value;
			inputEl.value = '';
			executeCommand(val);
		});

		inputEl?.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowUp') {
				e.preventDefault();
				if (historyIdx > 0) {
					historyIdx--;
					inputEl.value = cmdHistory[historyIdx] || '';
				}
			} else if (e.key === 'ArrowDown') {
				e.preventDefault();
				if (historyIdx < cmdHistory.length - 1) {
					historyIdx++;
					inputEl.value = cmdHistory[historyIdx] || '';
				} else {
					historyIdx = cmdHistory.length;
					inputEl.value = '';
				}
			}
		});

		// Quick-command chips
		chips.forEach(chip => {
			chip.addEventListener('click', () => {
				const cmd = chip.getAttribute('data-cmd');
				if (cmd) {
					executeCommand(cmd);
					if (inputEl) inputEl.focus();
				}
			});
		});

		// WebMCP: Register Profile tool for AI browsers (Progressive Enhancement)
		if (typeof navigator !== 'undefined' && 'modelContext' in navigator) {
			(navigator as any).modelContext.registerTool({
				name: 'getProfile',
				description: 'Provides profile, expertise and contact details of Alexander Ohl (AI Automation Engineer).',
				parameters: { type: 'object', properties: {} },
				execute: async () => ({
					status: 'success',
					name: 'Alexander Ohl',
					role: 'AI Automation Engineer & Full-Stack Developer',
					skills: ['AI Automation (RAG, n8n, Agents)', 'Web Development (React, Next.js, Astro)', 'SEO & GEO', 'E-Commerce'],
					area: 'DACH · Remote',
					contact: 'info@pragma-code.de',
					company: 'https://www.pragma-code.de/en'
				})
			});
		}
	</script>

