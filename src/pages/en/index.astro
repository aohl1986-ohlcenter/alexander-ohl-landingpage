	<script>
		import { readCommits, gitLog, findCommit, gitShow, stackJson } from '../../scripts/terminal-git';

		// Terminal-Typing with authentic character-by-character timing and interactive CLI
		const initialLines = [
			{ cmd: 'whoami', out: 'Alexander Ohl — AI Automation Engineer & Full-Stack Developer' },
			{ cmd: 'cat stack.txt', out: 'Web · SEO/GEO · AI Automation · E-Commerce' },
			{ cmd: './verfuegbarkeit.sh', out: '● available for projects — DACH · Remote' }
		];
		const PROMPT_STR = 'alexander@ohl ~ % ';
		const typingEl = document.getElementById('term-typing');
		const historyEl = document.getElementById('term-history');
		const inputEl = document.getElementById('term-input') as HTMLInputElement | null;
		const formEl = document.getElementById('term-form');
		const containerEl = document.getElementById('term-container');
		const chips = document.querySelectorAll('.term-chip');
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		let isTyping = true;
		let activeTypingAbort: (() => void) | null = null;
		const cmdHistory: string[] = [];
		let historyIdx = -1;
		const sleep = (ms: number) => new Promise(r => setTimeout(r, ms));

		// Single source for "skills" and "stack --json"
		const STACK = [
			{ key: 'frontend', label: 'Frontend', items: ['React', 'Next.js', 'Astro', 'TypeScript', 'Tailwind CSS'] },
			{ key: 'backend', label: 'Backend', items: ['Node.js', 'Python', 'PHP', 'REST APIs', 'SQL', 'Docker', 'Git'] },
			{ key: 'ai_automation', label: 'AI & Automation', items: ['n8n', 'RAG pipelines', 'LLM agents', 'Gemini API', 'RPA'] },
			{ key: 'visibility_commerce', label: 'Visibility & Commerce', items: ['SEO', 'GEO (Generative Engine Optimization)', 'Shopify', 'WooCommerce', 'JTL'] }
		];
		const commits = readCommits();
		const GIT_TIP = 'Tip: click a hash or type git show <hash>';

		const COMMANDS: Record<string, string> = {
			help: `Available commands:
  whoami       - Bio & role overview of Alexander Ohl
  git log      - Career history as commits
  git show     - Details on one station (git show <hash>)
  skills       - Tech stack, languages & frameworks
  stack --json - Tech stack as JSON
  principles   - 4 core engineering & architecture principles
  projects     - Featured client projects & SaaS products
  call         - Schedule a 20-min discovery call
  pricing      - Packages, fixed prices & retainers
  contact      - Contact options (Email, quote request)
  clear        - Clear terminal screen`,

			whoami: `Alexander Ohl — AI Automation Engineer & Founder of Pragma-Code.
15+ years of practical experience in software architecture, AI automation (n8n, RAG), SEO & GEO, and e-commerce in the DACH region.`,

			skills: `⚡ Tech Stack & Core Competencies:\n${STACK.map(s => `• ${s.label}: ${s.items.join(', ')}`).join('\n')}`,

			principles: `⚙️ 4 Engineering Principles:
1. No Vendor Lock-in (Open-Source-First, 100% data autonomy)
2. Measurable ROI Over Hype (Saved hours, qualified leads & citations)
3. Radical Performance (Sub-second load times, Core Web Vitals 100/100)
4. GDPR & Data Sovereignty (European hosting, on-premise LLMs)`,

			projects: `📁 Featured Client Projects & Case Studies:
• EsenTrans (esentrans.de): Custom WordPress Schema plugin (+111% clicks)
• AI Citation Tracker (pragma-code.de): Multi-tenant SaaS for LLM citations
• ImkerPur (imkerpur.de/lp): JTL-Shop & SEO landing pages
• N&W Reisemobile (n-w-reisemobile.de): Web presence, SEO & social media
• Physiotherapie Osnabrück: Website & local SEO
• Shooting Solutions (shooting-solutions.de): 6-month SEO sprint`,

			call: `📅 Book a free 20-min discovery call with Alexander:
👉 https://calendly.com/pragma-code-info/discovery-call`,

			pricing: `💰 Packages & Pricing at Pragma-Code:
• AI Visibility Monitoring: from €149/month (cancel monthly)
• Monthly Retainers (Web/SEO/AI): from €390/month
• Fixed-Price Projects & Audits: from €690
Overview: https://www.pragma-code.de/en/packages-pricing`,

			contact: `📬 Get in touch:
• Email: info@pragma-code.de
• Project inquiry: https://www.pragma-code.de/projektanfrage
• LinkedIn: https://www.linkedin.com/in/alexander-ohl/`,

			sudo: `zsh: permission denied: Nice try! You already have full developer access to explore the site.
Tip: sudo hire alexander`,

			'sudo hire alexander': `[sudo] password for guest: ********
Access granted. Next step: a free 20-min discovery call.
👉 https://calendly.com/pragma-code-info/discovery-call`,

			'git status': `On branch main
Your branch is up to date with 'origin/main'.

nothing to commit, working tree clean
${initialLines[2].out}`,

			ls: '.git/  stack.txt  verfuegbarkeit.sh'
		};

		function escapeHtml(str: string) {
			return str
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;');
		}

		function formatOutputHtml(text: string) {
			const escaped = escapeHtml(text);
			return escaped.replace(
				/(https?:\/\/[^\s]+)/g,
				'<a href="$1" target="_blank" rel="noopener" style="color:var(--pc-yellow);text-decoration:underline;">$1</a>'
			);
		}

		// New entry with prompt line; finish any ongoing typing output first
		function createEntry(cmd: string) {
			if (activeTypingAbort) {
				activeTypingAbort();
				activeTypingAbort = null;
			}
			const item = document.createElement('div');
			item.className = 'term-entry';
			item.innerHTML = `<div class="term-line"><span class="p pc-mono">${PROMPT_STR}</span><span class="cmd-text">${escapeHtml(cmd)}</span></div><div class="o pc-mono"></div>`;
			historyEl!.appendChild(item);
			return item;
		}

		// Long output (git log) stays anchored at its start instead of jumping to the end
		function follow(item: HTMLElement) {
			if (!containerEl) return;
			if (item.offsetHeight > containerEl.clientHeight) {
				containerEl.scrollTop += item.getBoundingClientRect().top - containerEl.getBoundingClientRect().top - 8;
			} else {
				containerEl.scrollTop = containerEl.scrollHeight;
			}
		}

		// Line by line like a real shell instead of typed; `lines` is ready-made HTML
		async function appendLines(cmd: string, lines: string[]) {
			if (!historyEl) return;
			const item = createEntry(cmd);
			const outDiv = item.querySelector('.o') as HTMLDivElement;
			let aborted = false;
			activeTypingAbort = () => {
				aborted = true;
				outDiv.innerHTML = lines.join('');
				follow(item);
			};
			for (const line of lines) {
				if (aborted) return;
				outDiv.insertAdjacentHTML('beforeend', line);
				follow(item);
				if (!reduced) await sleep(28);
			}
			if (!aborted) activeTypingAbort = null;
		}

		async function appendOutput(cmd: string, output: string) {
			if (!historyEl) return;
			const item = createEntry(cmd);

			const outDiv = item.querySelector('.o') as HTMLDivElement | null;
			if (!outDiv || !output) {
				if (containerEl) containerEl.scrollTop = containerEl.scrollHeight;
				return;
			}

			if (reduced) {
				outDiv.innerHTML = formatOutputHtml(output);
				if (containerEl) containerEl.scrollTop = containerEl.scrollHeight;
				return;
			}

			let aborted = false;
			activeTypingAbort = () => {
				aborted = true;
				outDiv.innerHTML = formatOutputHtml(output);
				if (containerEl) containerEl.scrollTop = containerEl.scrollHeight;
			};

			let typed = '';

			for (let i = 0; i < output.length; i++) {
				if (aborted) return;
				typed += output[i];
				outDiv.innerHTML = formatOutputHtml(typed) + '<span class="cursor"></span>';
				if (containerEl) containerEl.scrollTop = containerEl.scrollHeight;

				const ch = output[i];
				if (ch === '\n') {
					await sleep(45);
				} else if (ch === ' ') {
					await sleep(10);
				} else {
					await sleep(12 + Math.random() * 14);
				}
			}

			if (!aborted) {
				outDiv.innerHTML = formatOutputHtml(output);
				activeTypingAbort = null;
				if (containerEl) containerEl.scrollTop = containerEl.scrollHeight;
			}
		}

		function executeCommand(rawCmd: string) {
			const cmd = rawCmd.trim().toLowerCase().replace(/\s+/g, ' ');
			if (!cmd) return;

			if (isTyping) {
				renderStaticInitial();
			}

			cmdHistory.push(rawCmd);
			historyIdx = cmdHistory.length;

			if (cmd === 'clear') {
				if (activeTypingAbort) {
					activeTypingAbort();
					activeTypingAbort = null;
				}
				if (typingEl) typingEl.innerHTML = '';
				if (historyEl) historyEl.innerHTML = '';
				return;
			}

			if (Object.hasOwn(COMMANDS, cmd)) {
				appendOutput(rawCmd, COMMANDS[cmd]);
			} else if (cmd === 'git log' || cmd === 'git log --oneline' || cmd === 'git log --reverse') {
				appendLines(rawCmd, gitLog(commits, GIT_TIP, cmd.endsWith('--reverse')));
			} else if (cmd === 'git show' || cmd.startsWith('git show ')) {
				const rev = cmd.slice('git show '.length);
				const commit = findCommit(commits, rev);
				if (commit) appendLines(rawCmd, gitShow(commits, commit));
				else appendOutput(rawCmd, `fatal: ambiguous argument '${rev}': unknown revision. 'git log' lists the hashes.`);
			} else if (cmd === 'git' || cmd.startsWith('git ')) {
				appendOutput(rawCmd, 'Available: git log, git show <hash>, git status');
			} else if (cmd === 'stack --json') {
				appendLines(rawCmd, stackJson(Object.fromEntries(STACK.map(s => [s.key, s.items]))));
			} else if (cmd === 'sudo hire') {
				appendOutput(rawCmd, COMMANDS['sudo hire alexander']);
			} else if (cmd.startsWith('sudo ')) {
				appendOutput(rawCmd, COMMANDS['sudo']);
			} else if (cmd === 'ls -a' || cmd === 'ls -la' || cmd === 'll') {
				appendOutput(rawCmd, COMMANDS['ls']);
			} else if (cmd === 'cat stack.txt') {
				appendOutput(rawCmd, initialLines[1].out);
			} else if (cmd === './verfuegbarkeit.sh' || cmd === 'sh verfuegbarkeit.sh') {
				appendOutput(rawCmd, initialLines[2].out);
			} else if (cmd === 'stack') {
				appendOutput(rawCmd, COMMANDS['skills']);
			} else if (cmd === 'refs' || cmd === 'cases') {
				appendOutput(rawCmd, COMMANDS['projects']);
			} else if (cmd === 'book' || cmd === 'appointment') {
				appendOutput(rawCmd, COMMANDS['call']);
			} else if (cmd === 'mail' || cmd === 'email') {
				appendOutput(rawCmd, COMMANDS['contact']);
			} else {
				appendOutput(rawCmd, `zsh: command not found: ${cmd}. Type 'help' for available commands.`);
			}
		}

		// Initial Typewriting
		function renderStaticInitial() {
			if (!typingEl) return;
			typingEl.innerHTML = initialLines.map(l =>
				`<div class="term-line"><span class="p pc-mono">${PROMPT_STR}</span><span class="cmd-text">${l.cmd}</span></div><div class="o pc-mono">${l.out}</div>`
			).join('');
			isTyping = false;
		}

		async function runTypewriter() {
			if (!typingEl) return;
			const sleep = (ms: number) => new Promise(r => setTimeout(r, ms));
			let html = '';
			for (const l of initialLines) {
				if (!isTyping) break;
				html += `<div class="term-line"><span class="p pc-mono">${PROMPT_STR}</span><span class="cmd-text">`;
				for (const ch of l.cmd) {
					if (!isTyping) break;
					html += ch === '<' ? '&lt;' : ch;
					typingEl.innerHTML = html + '<span class="cursor"></span></span></div>';
					if (containerEl) containerEl.scrollTop = containerEl.scrollHeight;
					await sleep(38 + Math.random() * 45);
				}
				if (!isTyping) break;
				await sleep(260);
				html += `</span></div>\n<div class="o pc-mono">${l.out}</div>\n`;
				typingEl.innerHTML = html;
				if (containerEl) containerEl.scrollTop = containerEl.scrollHeight;
				await sleep(420);
			}
			isTyping = false;
			if (containerEl) containerEl.scrollTop = containerEl.scrollHeight;
		}

		if (reduced) {
			renderStaticInitial();
		} else {
			runTypewriter();
		}

		// Event listener for form & input
		formEl?.addEventListener('submit', (e) => {
			e.preventDefault();
			if (!inputEl) return;
			const val = inputEl.value;
			inputEl.value = '';
			executeCommand(val);
		});

		inputEl?.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowUp') {
				e.preventDefault();
				if (historyIdx > 0) {
					historyIdx--;
					inputEl.value = cmdHistory[historyIdx] || '';
				}
			} else if (e.key === 'ArrowDown') {
				e.preventDefault();
				if (historyIdx < cmdHistory.length - 1) {
					historyIdx++;
					inputEl.value = cmdHistory[historyIdx] || '';
				} else {
					historyIdx = cmdHistory.length;
					inputEl.value = '';
				}
			}
		});

		// Hashes in the git log output run git show
		historyEl?.addEventListener('click', (e) => {
			const hash = (e.target as HTMLElement).closest<HTMLButtonElement>('.term-hash');
			if (hash?.dataset.cmd) executeCommand(hash.dataset.cmd);
		});

		// Quick-command chips
		chips.forEach(chip => {
			chip.addEventListener('click', () => {
				const cmd = chip.getAttribute('data-cmd');
				if (cmd) {
					executeCommand(cmd);
					if (inputEl) inputEl.focus();
				}
			});
		});

		// WebMCP: Register Profile tool for AI browsers (Progressive Enhancement)
		if (typeof navigator !== 'undefined' && 'modelContext' in navigator) {
			(navigator as any).modelContext.registerTool({
				name: 'getProfile',
