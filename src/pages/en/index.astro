	{ url: 'https://www.n-w-reisemobile.de/', host: 'n-w-reisemobile.de', name: 'N&W Reisemobile', meta: 'Camper rental · Bad Essen', text: 'Complete digital revamp: Responsive website, search engine optimization and social media presence for a significant boost in booking requests.' },
	{ url: 'https://xn--physiotherapie-osnabrck-wpc.com/', host: 'physiotherapie-osnabrück.com', name: 'Physiotherapie Osnabrück', meta: 'Physiotherapy clinic · Osnabrück', text: 'Website redesign, Local SEO and social media presence: substantial increase in online visibility and patient appointment requests.' },
	{ url: 'https://k-kbau.de/', host: 'k-kbau.de', name: 'K&K Bau GbR', meta: 'Construction company · Structural engineering', text: 'Designed, built and SEO-optimized the entire corporate web presence from scratch.' },
	{ url: 'https://www.alando-palais.de/', host: 'alando-palais.de', name: 'Alando Palais', meta: 'Hotel · Bar · Event venue · Osnabrück', text: 'Upgraded online presence in partnership with Next Choice agency — Google Business profile and active reputation management.' },
	{ url: 'https://www.kasinopark.com/', host: 'kasinopark.com', name: 'Kasinopark', meta: 'Community venue · Georgsmarienhütte', text: 'Multi-year engagement: Web development, online presence, digital marketing and SEO care.' },
	{ url: 'https://yms-osnabrueck.de/', host: 'yms-osnabrueck.de', name: 'YMS Osnabrück', meta: 'Osnabrück', text: 'Over a year of comprehensive support: SEO, online visibility, Google Business optimization and social media.' },
];

// Featured Thought Leadership & Technical Deep-Dives from Pragma-Code
const articles: { tag: string; time: string; year: string; title: string; desc: string; url: string }[] = [
	{
		tag: 'GEO & AI Search',
		time: '8 min read',
		year: '2026',
