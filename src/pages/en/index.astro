// 4 non-negotiable engineering & architecture principles
const principles: { num: string; title: string; desc: string }[] = [
	{
		num: '01',
		title: 'No Vendor Lock-in (Open-Source-First)',
		desc: 'Open standards, n8n, Next.js, Astro, PostgreSQL, and clean REST APIs. You maintain 100% ownership and full autonomy over your code, workflows, and data at all times.'
	},
	{
		num: '02',
		title: 'Measurable ROI Over Hype',
		desc: 'No theoretical AI gimmicks. Every automation and engineering project is measured against tangible metrics: saved work hours, qualified leads, and measurable citations.'
	},
	{
		num: '03',
		title: 'Radical Performance & Core Web Vitals',
		desc: 'Sub-second load times, lightweight code, and flawless Lighthouse scores (100/100). Speed directly drives conversion rates and search engine rankings.'
	},
	{
		num: '04',
		title: 'GDPR & Data Sovereignty (DACH Hosting)',
		desc: 'Strict compliance with European data privacy standards (GDPR, EU AI Act). Optional self-hosted and on-premise LLM setups for sensitive corporate data.'
	}
];

