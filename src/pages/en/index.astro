			background: var(--pc-navy-700); overflow: hidden;
		}
		@media (max-width: 720px) { .stats-inner { grid-template-columns: repeat(2, 1fr); } }
		.stat { padding: clamp(18px, 3vw, 30px); border-right: 1px solid var(--pc-line); }
		.stat:last-child { border-right: none; }
		@media (max-width: 720px) {
			.stat:nth-child(2) { border-right: none; }
			.stat:nth-child(-n+2) { border-bottom: 1px solid var(--pc-line); }
		}
		.num { font-size: clamp(30px, 4vw, 44px); font-weight: 800; letter-spacing: -0.02em; }
		.num span { color: var(--pc-yellow); }
		.lab { font-size: 13px; color: var(--pc-fg-2); margin-top: 4px; }

		/* ===== Ticker ===== */
		.ticker {
			margin-top: clamp(40px, 6vw, 72px); border-block: 1px solid var(--pc-line);
			overflow: hidden; background: var(--pc-navy-900); padding: 14px 0;
		}
		.ticker-track { display: flex; gap: 40px; width: max-content; animation: scroll 48s linear infinite; }
		@media (prefers-reduced-motion: reduce) { .ticker-track { animation: none; } }
		@keyframes scroll { to { transform: translateX(-50%); } }
		.ticker-item {
			font-family: var(--pc-font-mono); font-size: 12.5px; letter-spacing: 0.08em;
			text-transform: uppercase; color: var(--pc-fg-3); white-space: nowrap;
			text-decoration: none;
		}
		a.ticker-item { transition: color var(--pc-fast) var(--pc-ease); }
		a.ticker-item:hover { color: var(--pc-yellow); }
		.ticker-item::after { content: '·'; margin-left: 40px; color: var(--pc-yellow); }

		/* ===== Sections ===== */
		.sec { padding: clamp(64px, 9vw, 120px) 0; }
		.sec-alt { background: var(--pc-navy-900); border-block: 1px solid var(--pc-line); }
		.sec-eyebrow { color: var(--pc-yellow); margin-bottom: 14px; }
		.sec-title {
			font-size: clamp(26px, 3.6vw, 40px); font-weight: 800; letter-spacing: -0.02em;
			margin-bottom: 18px;
		}
		.sec-lede { color: var(--pc-fg-2); max-width: 68ch; margin-bottom: clamp(28px, 4vw, 48px); }

		/* Expertise cards */
		.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; margin-top: clamp(28px, 4vw, 44px); }
		.card {
			background: var(--pc-navy-700); border: 1px solid var(--pc-line);
			border-radius: var(--pc-r-lg); padding: 26px;
			transition: transform var(--pc-base) var(--pc-ease), border-color var(--pc-base) var(--pc-ease);
		}
		.card:hover { transform: translateY(-4px); border-color: rgba(255, 200, 41, 0.4); }
		.card-icon {
			color: var(--pc-yellow);
			width: 46px; height: 46px; display: grid; place-items: center;
			background: rgba(255, 200, 41, 0.08); border: 1px solid rgba(255, 200, 41, 0.25);
			border-radius: var(--pc-r-md); margin-bottom: 18px;
		}
		.card-icon svg { width: 24px; height: 24px; }
		.card h3 { font-size: 18px; font-weight: 800; margin-bottom: 10px; }
		.card p { font-size: 14.5px; color: var(--pc-fg-2); margin-bottom: 16px; }
		.card-chips { display: flex; flex-wrap: wrap; gap: 8px; }
		.card-chips span {
			font-family: var(--pc-font-mono); font-size: 11px; padding: 4px 10px;
			border: 1px solid var(--pc-line-2); border-radius: var(--pc-r-pill); color: var(--pc-fg-3);
		}
		.card-cta {
			display: inline-flex; align-items: center; gap: 6px; margin-top: 18px;
			font-size: 13px; font-weight: 700; color: var(--pc-yellow); text-decoration: none;
			transition: gap var(--pc-fast) var(--pc-ease);
		}
		.card-cta:hover { gap: 10px; }

		/* Principles Grid */
		.principles-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-top: clamp(28px, 4vw, 44px); }
		.principle-card {
			background: var(--pc-navy-700); border: 1px solid var(--pc-line);
			border-radius: var(--pc-r-lg); padding: 26px;
			transition: transform var(--pc-base) var(--pc-ease), border-color var(--pc-base) var(--pc-ease);
		}
		.principle-card:hover { transform: translateY(-4px); border-color: rgba(255, 200, 41, 0.4); }
		.principle-num { font-size: 14px; font-weight: 800; color: var(--pc-yellow); margin-bottom: 12px; }
		.principle-card h3 { font-size: 17.5px; font-weight: 800; margin-bottom: 10px; }
		.principle-card p { font-size: 14px; color: var(--pc-fg-2); line-height: 1.6; }

		/* Timeline */
		.tl { list-style: none; padding: 0; position: relative; max-width: 760px; }
		.tl::before {
			content: ''; position: absolute; left: 74px; top: 8px; bottom: 8px; width: 2px;
			background: linear-gradient(to bottom, var(--pc-yellow), rgba(255, 200, 41, 0.08));
		}
		.tl-item { display: grid; grid-template-columns: 56px 1fr; gap: 36px; padding: 0 0 34px; position: relative; }
		.tl-item::before {
			content: ''; position: absolute; left: 69px; top: 7px; width: 12px; height: 12px;
			border-radius: 50%; background: var(--pc-navy-800); border: 2px solid var(--pc-yellow);
		}
		.tl-year { color: var(--pc-yellow); font-size: 13px !important; padding-top: 5px; text-align: right; }
		.tl-body h3 { font-size: 17px; font-weight: 800; margin-top: 4px; }
		.tl-org {
			font-family: var(--pc-font-mono); font-size: 12.5px; color: var(--pc-yellow);
			text-decoration: none; font-weight: 600;
		}
		.tl-body p { font-size: 14.5px; color: var(--pc-fg-2); max-width: 62ch; margin-top: 4px; }
		@media (max-width: 560px) {
			.tl::before { left: 5px; }
			.tl-item { grid-template-columns: 1fr; gap: 6px; padding-left: 28px; }
			.tl-item::before { left: 0; }
			.tl-year { text-align: left; padding-top: 0; }
		}

		/* Education */
		.edu { margin-top: clamp(28px, 4vw, 44px); border-top: 1px solid var(--pc-line); padding-top: 28px; }
		.edu-label { color: var(--pc-fg-3); margin-bottom: 14px; }
		.edu-chips { display: flex; flex-wrap: wrap; gap: 10px; }
		.edu-chip {
			font-size: 13px; color: var(--pc-fg-2); padding: 8px 14px;
			border: 1px solid var(--pc-line-2); border-radius: var(--pc-r-pill); background: rgba(255,255,255,0.02);
		}
		.edu-chip strong { color: var(--pc-yellow); font-family: var(--pc-font-mono); font-weight: 600; margin-right: 4px; }

		/* References */
		.refs { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; margin-top: clamp(28px, 4vw, 44px); }
		.ref {
			display: block; text-decoration: none; background: var(--pc-navy-700);
			border: 1px solid var(--pc-line); border-radius: var(--pc-r-lg); padding: 24px;
			transition: transform var(--pc-base) var(--pc-ease), border-color var(--pc-base) var(--pc-ease);
		}
		.ref:hover { transform: translateY(-4px); border-color: rgba(255, 200, 41, 0.4); }
		.ref-host { color: var(--pc-green); margin-bottom: 12px; }
		.ref h3 { font-size: 17px; font-weight: 800; margin-bottom: 2px; }
		.ref-meta { font-size: 12.5px; color: var(--pc-fg-3); margin-bottom: 10px; }
		.ref-metric {
			display: inline-block; margin-bottom: 10px; padding: 4px 10px;
			border: 1px solid color-mix(in srgb, var(--pc-yellow) 45%, transparent);
			background: color-mix(in srgb, var(--pc-yellow) 12%, transparent);
			border-radius: 999px; font-size: 12.5px; font-weight: 600;
			color: var(--pc-yellow); line-height: 1.35;
		}
		.ref p { font-size: 14px; color: var(--pc-fg-2); }
		.refs-more { margin-top: 28px; font-size: 14px; color: var(--pc-fg-2); }
		.refs-more a { color: var(--pc-yellow); text-decoration: none; border-bottom: 1px solid rgba(255,200,41,.35); }

		/* Articles Grid */
		.articles-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-top: clamp(28px, 4vw, 44px); }
		.article-card {
			display: flex; flex-direction: column; text-decoration: none;
			background: var(--pc-navy-700); border: 1px solid var(--pc-line);
			border-radius: var(--pc-r-lg); padding: 26px;
			transition: transform var(--pc-base) var(--pc-ease), border-color var(--pc-base) var(--pc-ease);
		}
		.article-card:hover { transform: translateY(-4px); border-color: rgba(255, 200, 41, 0.4); }
		.article-meta { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 14px; }
		.article-tag {
			font-family: var(--pc-font-mono); font-size: 11px; font-weight: 700;
			color: var(--pc-yellow); background: rgba(255, 200, 41, 0.1);
			border: 1px solid rgba(255, 200, 41, 0.25); border-radius: var(--pc-r-pill);
			padding: 3px 10px;
		}
		.article-time { font-size: 12px; color: var(--pc-fg-3); }
		.article-card h3 { font-size: 17.5px; font-weight: 800; line-height: 1.35; margin-bottom: 12px; color: var(--pc-fg); }
		.article-card h3 .arr { color: var(--pc-yellow); display: inline-block; transition: transform var(--pc-fast) var(--pc-ease); }
		.article-card:hover h3 .arr { transform: translate(3px, -3px); }
		.article-card p { font-size: 14px; color: var(--pc-fg-2); line-height: 1.6; margin-bottom: 18px; flex: 1; }
		.article-link { font-size: 13px; font-weight: 700; color: var(--pc-yellow); }

		/* Contact */
		.contact { text-align: center; max-width: 760px; margin: 0 auto; }
		.contact .sec-lede { margin-inline: auto; }
		.contact-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }

		/* Footer */
		.ft { border-top: 1px solid var(--pc-line); padding: 24px 0 28px; background: var(--pc-navy-900); }
		.ft-social-row {
			display: flex; flex-wrap: wrap; gap: 14px 28px; align-items: center;
			justify-content: space-between; padding-bottom: 20px; margin-bottom: 20px;
			border-bottom: 1px solid var(--pc-line);
		}
		.ft-status {
			display: inline-flex; align-items: center; gap: 9px;
			font-size: 13px; font-weight: 700; color: var(--pc-green);
			padding: 8px 16px; border: 1px solid rgba(74, 222, 128, 0.25);
			border-radius: var(--pc-r-pill); background: rgba(74, 222, 128, 0.06);
		}
		.ft-social { display: flex; flex-wrap: wrap; gap: 8px; }
		.ft-social a {
			font-family: var(--pc-font-mono); font-size: 12px; text-decoration: none;
			color: var(--pc-fg-2); padding: 7px 13px; border: 1px solid var(--pc-line-2);
			border-radius: var(--pc-r-pill);
			transition: border-color var(--pc-fast) var(--pc-ease), color var(--pc-fast) var(--pc-ease);
		}
		.ft-social a:hover { border-color: var(--pc-yellow); color: var(--pc-yellow); }
		.ft-inner { display: flex; flex-wrap: wrap; gap: 14px 28px; align-items: center; justify-content: space-between; }
		.ft-brand { color: var(--pc-fg-2); }
		.ft-nav { display: flex; flex-wrap: wrap; gap: 20px; }
		.ft-nav a { font-size: 13px; color: var(--pc-fg-2); text-decoration: none; }
		.ft-nav a:hover { color: var(--pc-fg); }
	</style>
</Layout>
